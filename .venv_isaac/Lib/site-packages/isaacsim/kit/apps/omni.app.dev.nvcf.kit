[package]
title = "Kit Dev App (NVCF Streaming)"
description = "Kit Dev App configured for NVCF streaming deployment on DGXC."
version = "1.0.0"
keywords = ["app", "streaming", "nvcf", "dgxc"]
support_level = "Sample"

[dependencies]
# Base application
"omni.app.dev" = {}

# NVCF Streaming - brings in omni.kit.livestream.webrtc and other streaming dependencies
# Implements health check endpoints (/v1/streaming/ready) and manages session lifecycle
"omni.services.livestream.session" = {}

# Geometry caching for faster load times on large USD scenes
"omni.ujitso.client" = {}

# Nucleus server connection support for cloud deployments
"omni.cloud.open_stage" = {}

[settings.app]
name = "Kit Dev App NVCF Streaming"
ovc_deployment = true
renderer.resolution.height = 1080
renderer.resolution.width = 1920
window.height = 1080
window.width = 1920
window.title = "Kit Dev App (Streaming)"

[settings.app.file]
ignoreUnsavedOnExit = true

[settings.app.extensions]
# Disable registry for self-contained NVCF deployment
# All required extensions must be present in the container
registryEnabled = false

[settings.app.exts.folders]
# Search paths for precached extensions from registry
'++' = ["${app}/../extscache"]

[settings]
# RTX performance settings for streaming
rtx.post.aa.op = 3
rtx.hydra.geometrystreaming.gpuBudgetMB = 64000
rtx.hydra.geometrystreaming.instanceBudget = 14388608
rtx.verifyDriverVersion.enabled = false
rtx-transient.dlssg.enabled = true
rtx-transient.scenedb.forceMaxTLASInstancesLimit = 15000000
rtx-transient.scenedb.instanceBudget = 1000000

# Hide "My Computer" from file picker and content browser for cloud deployment
# This prevents users from accessing the container's local filesystem
[settings.exts."omni.kit.window.filepicker"]
show_only_collections.6 = ""
show_add_new_connection = false

[settings.exts."omni.kit.window.content_browser"]
show_only_collections.6 = ""
