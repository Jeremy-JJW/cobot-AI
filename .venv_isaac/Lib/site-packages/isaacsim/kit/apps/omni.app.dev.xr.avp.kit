[package]
title = "Kit XR Dev App"
description = "Default app kit runs. Minimal USD viewer."
version = "1.0.0"
keywords = ["app"]
support_level = "Sample"

[dependencies]
# The Main UI App. Bring everything needed for UI application.
"omni.kit.uiapp" = {}

# USD file open/close
"omni.kit.window.file" = {}

# Basic Menus
"omni.kit.menu.utils" = {}
"omni.kit.menu.file" = {}
"omni.kit.menu.edit" = {}
"omni.kit.menu.create" = {}
"omni.kit.menu.common" = {}
"omni.kit.menu.aov" = {}
"omni.kit.context_menu" = {}
"omni.kit.selection" = {}

# Stage Templates
"omni.kit.stage_templates" = {}

# Some Editing Windows
"omni.kit.window.title" = {}
"omni.kit.widget.live" = {}
"omni.kit.widget.cache_indicator" = {}
"omni.kit.window.stage" = {}
"omni.kit.window.toolbar" = {}
"omni.kit.widget.filebrowser" = {}
"omni.kit.window.filepicker" = {}
"omni.kit.window.content_browser" = {}
"omni.kit.collaboration.channel_manager" = {}
"omni.kit.collaboration.viewport.camera" = {}
"omni.kit.collaboration.selection_outline" = {}
"omni.kit.collaboration.stage_columns" = {}
"omni.kit.stage_column.active" = {}

# Tools
"omni.kit.tool.collect" = {}

# Viewport and Renderer
"omni.kit.viewport.bundle" = {}
"omni.kit.viewport.rtx" = {}
# "omni.kit.viewport.pxr" = {}
# "omni.kit.viewport.iray" = {}
"omni.resourcemonitor" = {}

# MDL
"omni.mdl" = {}
"omni.mdl.neuraylib" = {}

# Usd MDL plugins
"omni.kit.usd.mdl" = {}

# RTX Tests
# "omni.rtx.tests" = {}
# "omni.kit.renderer.capture" = {}

# Status Bar
"omni.kit.window.status_bar" = {}

# Graphics Stats
"omni.stats" = {}

# Render Settings 2.0
"omni.rtx.settings.core" = {}

# Dev & Utils Windows
"omni.kit.window.about" = {}
"omni.kit.window.stats" = { order = 1000 }
"omni.kit.window.script_editor" = {}
"omni.kit.window.console" = {}
"omni.kit.window.preferences" = { order = 1000 } # so the menu is in the correct place
"omni.kit.window.tests" = {}

# Extensions Manager UI
"omni.kit.window.extensions" = {}

# Property Widgets and Window
"omni.kit.window.property" = {}
"omni.kit.property.bundle" = {}

# Misc
"omni.kit.primitive.mesh" = {}
"omni.kit.telemetry" = {}

# XR
"omni.kit.xr.bundle.apple_vision_pro" = {}

[settings.app.settings]
persistent = true

[settings]
exts."omni.kit.window.file".useNewFilePicker = true
exts."omni.kit.renderer.core".imgui.enableMips = true
app.content.emptyStageOnStart = true

app.extensions.enabledDeprecated = []

# XR settings
xr.debug = true
renderer.enabled = 'rtx'
renderer.active ='rtx'
renderer.multiGpu.enabled = true

persistent.rtx.modes.pt.enabled = false
persistent.rtx.modes.rt2.enabled = true

# Simulated XR settings to mimic AVP
persistent.xr.profile.ar.foveation.warped.resolutionMultiplier=0.40
persistent.xr.profile.ar.foveation.warped.insetSize=0.60
persistent.xr.profile.ar.simulatedxr.stereo.resolution.0=6000
persistent.xr.profile.ar.simulatedxr.stereo.resolution.1=4800
persistent.xr.profile.ar.simulatedxr.stereo.left.fovX.0=-1.4896
persistent.xr.profile.ar.simulatedxr.stereo.left.fovX.1=1.4896
persistent.xr.profile.ar.simulatedxr.stereo.left.fovY.0=-1.1917
persistent.xr.profile.ar.simulatedxr.stereo.left.fovY.1=1.1917
persistent.xr.profile.ar.simulatedxr.stereo.right.fovX.0=-1.4896
persistent.xr.profile.ar.simulatedxr.stereo.right.fovX.1=1.4896
persistent.xr.profile.ar.simulatedxr.stereo.right.fovY.0=-1.1917
persistent.xr.profile.ar.simulatedxr.stereo.right.fovY.1=1.1917

# Sync materials in parallel from within Hydra
omnihydra.parallelHydraSprimSync = true

exts."omni.kit.viewport.window".startup.dockTabInvisible=true

[settings.app.window]
saveSizeOnExit = true
title = "Kit XR Dev App"
width = 1920
height = 1080
x = -1
y = -1
