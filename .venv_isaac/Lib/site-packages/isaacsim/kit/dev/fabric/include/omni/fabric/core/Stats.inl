namespace omni
{
namespace fabric
{

bool Stats::getMemoryStats(MemoryStatsC& memoryStats)
{
    return carb::getCachedInterface<omni::fabric::IStats>()->getMemoryStats(memoryStats);
}

void Stats::resetMemoryStats()
{
    carb::getCachedInterface<omni::fabric::IStats>()->resetMemoryStats();
}

} // namespace fabric
} // namespace omni
