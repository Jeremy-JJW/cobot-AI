inline void StageReaderWriter::copyAttributes(Path srcPath, const gsl::span<Token>& srcAttrs, Path destPath)
{
    m_interface->copySpecifiedAttributes(
        m_stageReaderWriterId, srcPath, (Token*)srcAttrs.data(), destPath, (Token*)srcAttrs.data(), srcAttrs.size());
}

inline void StageReaderWriter::copyAttributes(Path srcPath,
                                              const gsl::span<Token>& srcAttrs,
                                              Path destPath,
                                              const gsl::span<Token>& dstAttrs)
{
    if (srcAttrs.size() != dstAttrs.size())
