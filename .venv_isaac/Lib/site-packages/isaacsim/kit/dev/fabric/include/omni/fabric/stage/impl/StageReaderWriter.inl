inline std::pair<std::vector<Token>, std::vector<Type>> StageReaderWriter::getAttributeNamesAndTypes(Path path)
{
    std::vector<Token> outNames;
    std::vector<Type> outTypes;

    size_t count = m_interface->getAttributeCount(m_stageReaderWriterId, path);
    outNames.resize(count);
    outTypes.resize(count);

    m_interface->getAttributeNamesAndTypes((Token*)outNames.data(), outTypes.data(), count, m_stageReaderWriterId, path);

    return { outNames, outTypes };
}

