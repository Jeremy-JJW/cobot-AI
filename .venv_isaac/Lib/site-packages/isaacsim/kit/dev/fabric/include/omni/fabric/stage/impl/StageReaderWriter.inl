}

template <size_t n>
inline void StageReaderWriter::destroyAttributes(Path path, const std::array<Token, n>& attributes)
{
    std::array<Token, n> names;

    for (size_t c = 0; c < n; ++c)
    {
        names[c] = Token(attributes[c]);
    }

    m_interface->destroyAttributes(m_stageReaderWriterId, path, names.data(), n);
}

inline void StageReaderWriter::destroyAttributes(Path path, const std::vector<Token>& attributes)
{
    m_interface->destroyAttributes(m_stageReaderWriterId, path, (Token*)attributes.data(), (uint32_t)attributes.size());
}

