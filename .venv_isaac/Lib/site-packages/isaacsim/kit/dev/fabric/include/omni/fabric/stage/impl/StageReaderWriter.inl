// Specialization for Path (relationships)
// We used to store relationships as single paths, not arrays of paths
// To be backward compatible we do the following hack to allow the first
// element of a relationship array to be accessed as if it were a non-array attribute
inline Path* StageReaderWriter::getRelationshipAttribute(SpanWithTypeC spanWithType, Path path, Token attrName)
{
    // Make sure that the array has at least one element of the correct element size
    if (spanWithType.elementSize != sizeof(Path))
        return nullptr;
    else if (!spanWithType.elementCount)
    {
        m_interface->setArrayAttributeSize(m_stageReaderWriterId, path, attrName, 1);
        spanWithType = m_interface->getArrayAttribute(m_stageReaderWriterId, path, attrName);
        *spanWithType.getTypedPointer<Path>() = Path();
    }

    // internally, relationships are always stored as array attributes, so to get the first Path we need to dereference
    // the array attribute data pointer
    return spanWithType.getTypedPointer<Path>();
}

inline const Path* StageReaderWriter::getRelationshipAttribute(ConstSpanWithTypeC spanWithType, Path path, Token attrName)
{
    // Make sure that the array has at least one element of the correct element size
    if ((spanWithType.elementSize != sizeof(Path)) || !spanWithType.elementCount)
        return nullptr;

    spanWithType = m_interface->getArrayAttribute(m_stageReaderWriterId, path, attrName);

    // internally, relationships are always stored as array attributes, so to get the first Path we need to dereference
    // the array attribute data pointer
    return spanWithType.getTypedPointer<Path>();
}

template <>
inline Path* StageReaderWriter::getAttribute(Path path, Token attrName)
{
    SpanWithTypeC spanWithType = m_interface->getAttribute(m_stageReaderWriterId, path, attrName);
    Type attrType(spanWithType.type);
    if (attrType.baseType == BaseDataType::eRelationship)
    {
        return getRelationshipAttribute(
            m_interface->getArrayAttribute(m_stageReaderWriterId, path, attrName), path, attrName);
    }
    else if ((spanWithType.elementSize == sizeof(Path)) && attrType.isValid())
        return spanWithType.getTypedPointer<Path>();

    return nullptr;
}

