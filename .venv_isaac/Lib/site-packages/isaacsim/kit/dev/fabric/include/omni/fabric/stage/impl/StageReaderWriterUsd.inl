inline std::pair<std::vector<PXR_NS::TfToken>, std::vector<Type>> StageReaderWriterUsd::getAttributeNamesAndTypes(
    const PXR_NS::SdfPath& path)
{
    std::vector<PXR_NS::TfToken> outNames;
    std::vector<Type> outTypes;

    size_t count = m_interfaceUsd->getAttributeCount(m_stageReaderWriter, path);
    outNames.resize(count);
    outTypes.resize(count);

    m_interfaceUsd->getAttributeNamesAndTypes(outNames.data(), outTypes.data(), count, m_stageReaderWriter, path);

    return { outNames, outTypes };
}

