template <typename T>
Span<T> StageReaderWriterUsd::getAttributeArray(const PrimBucketList& primBucketList,
                                                size_t primBucketListIndex,
                                                const PXR_NS::TfToken& attrName)
{
    SpanWithTypeC array;

    m_interfaceUsd->getAttributeArray(&array, m_stageReaderWriter, primBucketList.getId(), primBucketListIndex, attrName);

    if (array.isValid())
    {
        carb::cpp::span<T> span = array.getTypedSpan<T>();
        return Span<T>(span.data(), span.size());
    }

    return Span<T>();
}

template <typename T>
Column<T> StageReaderWriterUsd::getAttributeColumn(const PrimBucketList& primBucketList,
                                                   size_t primBucketListIndex,
                                                   const PXR_NS::TfToken& attrName)
{
    size_t listenerCount = getListenerCount();
    std::vector<FineGrainedChangeTracker> dirtyElements(listenerCount);

    SpanWithTypeC array = m_interfaceUsd->getAttributeColumn(
        m_stageReaderWriter, Span<FineGrainedChangeTracker>(dirtyElements.begin(), dirtyElements.end()),
        primBucketList.getId(), primBucketListIndex, attrName, WriteType::eModify);

    if (!array.isValid())
    {
        return Column<T>();
    }

    carb::cpp::span<T> span = array.getTypedSpan<T>();
    return Column<T>(span.data(), span.size(), dirtyElements);
}

template <typename T>
Span<const T> StageReaderWriterUsd::getAttributeArrayRd(const PrimBucketList& primBucketList,
                                                        size_t primBucketListIndex,
                                                        const PXR_NS::TfToken& attrName) const
{
    ConstSpanWithTypeC array;

    m_interfaceUsd->getAttributeArrayRd(
        &array, m_stageReaderWriter, primBucketList.getId(), primBucketListIndex, attrName);

    if (array.isValid())
    {
        carb::cpp::span<const T> span = array.getTypedSpan<T>();
        return Span<const T>(span.data(), span.size());
    }

    return Span<const T>();
}

// getAttributeColumnRd intentionally does the same thing as
// getAttributeArrayRd.
// It is included just for completeness. A new user that was familar with
// columns might not know to use getAttributeArrayRd if they wanted
// read-only access.
// The return type is Span<const T> instead of Column,
// because Column does fine grained write tracking, and access through this
// method does not allow writes.
template <typename T>
Span<const T> StageReaderWriterUsd::getAttributeColumnRd(const PrimBucketList& primBucketList,
                                                         size_t primBucketListIndex,
                                                         const PXR_NS::TfToken& attrName) const
{
    return getAttributeArrayRd<T>(primBucketList, primBucketListIndex, attrName);
}

