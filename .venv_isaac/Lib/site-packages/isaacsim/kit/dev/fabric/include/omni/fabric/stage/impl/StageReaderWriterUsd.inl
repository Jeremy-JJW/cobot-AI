template <typename T>
std::vector<Span<T>> StageReaderWriterUsd::getArrayAttributeArray(const PrimBucketList& primBucketList,
                                                                  size_t primBucketListIndex,
                                                                  const PXR_NS::TfToken& attrName) const
{
    ArrayPointersAndSizesWithTypeC pointersAndSizes = m_interfaceUsd->getArrayAttributeArrayWithSizes(
        m_stageReaderWriter, primBucketList.getId(), primBucketListIndex, attrName);

    if (!VERIFY(Type(pointersAndSizes.type).isCompatibleWith<T>()))
    {
        return std::vector<Span<T>>();
    }

    size_t primCount = pointersAndSizes.elementCount;
    std::vector<Span<T>> arrays(primCount);
    for (size_t i = 0; i != primCount; i++)
    {
        T* ptr = reinterpret_cast<T*>(pointersAndSizes.arrayPtrs[i]);
        const size_t size = pointersAndSizes.sizes[i];
        if (ptr == nullptr || size == 0)
        {
            arrays[i] = Span<T>();
        }
        else
        {
            arrays[i] = Span<T>(ptr, size);
        }
    }

    return arrays;
}

