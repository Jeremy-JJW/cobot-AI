template <typename T>
Span<T> StageReaderWriterUsd::setArrayAttributeSizeAndGet(const PrimBucketList& primBucketList,
                                                          size_t primBucketListIndex,
                                                          size_t indexInBucket,
                                                          const PXR_NS::TfToken& attrName,
                                                          size_t newElemCount)
{
    SpanWithTypeC newArrayC = m_interfaceUsd->setArrayAttributeSizeAndGet(
        m_stageReaderWriter, primBucketList.getId(), primBucketListIndex, indexInBucket, attrName, newElemCount);

    T* ptr = reinterpret_cast<T*>(newArrayC.ptr);
    if (ptr != nullptr) // can't do a .isValid() check because elementSize is set to zero
    {
        carb::cpp::span<T> span = newArrayC.getTypedSpan<T>();
        return Span<T>(span.data(), span.size());
    }
    return Span<T>();
}

