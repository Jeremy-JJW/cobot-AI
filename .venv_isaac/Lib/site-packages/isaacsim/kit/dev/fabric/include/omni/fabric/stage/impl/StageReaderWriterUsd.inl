inline void StageReaderWriterUsd::createAttributes(const PXR_NS::SdfPath& path, Span<const AttrNameAndType> attributes)
{
    std::vector<Token> names(attributes.size());
    std::vector<TypeC> types(attributes.size());

    for (size_t c = 0; c < attributes.size(); ++c)
    {
        names[c] = attributes[c].name;
        types[c] = TypeC(attributes[c].type);
    }

    m_interfaceUsd->createAttributes(
        m_stageReaderWriter, path, (const Token*)names.data(), types.data(), (uint32_t)attributes.size());
}

