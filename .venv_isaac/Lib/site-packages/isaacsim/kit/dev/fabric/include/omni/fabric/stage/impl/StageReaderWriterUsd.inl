inline std::vector<PXR_NS::VtValue> StageReaderWriterUsd::getArrayAttributeArrayRd(const PrimBucketList& primBucketList,
                                                                                   size_t primBucketListIndex,
                                                                                   const PXR_NS::TfToken& attrName)
{
    // Get the number of prims in the bucket
    size_t primCount = m_interfaceUsd->getBucketPrimCount(m_stageReaderWriter,
                                                          primBucketList.getId(),
                                                          primBucketListIndex);

    // Early out if there are no prims in the bucket
    if (primCount == 0)
        return {};

    std::vector<PXR_NS::VtValue> result(primCount);
    ConstArrayPointersAndSizesWithTypeC span = m_interfaceUsd->getArrayAttributeArrayVtValueRd(m_stageReaderWriter,
                                                                primBucketList.getId(),
                                                                primBucketListIndex,
                                                                attrName,
                                                                Span<PXR_NS::VtValue>{result.data(), result.size()});

    // elementCount is 0 if the attribute does not exist in the bucket. Return an empty vector in that case.
    if (span.elementCount == 0)
        return {};

    // If the attribute exists, elementCount must match primCount
    CARB_ASSERT(span.elementCount == primCount);
    return result;
}

inline std::vector<PXR_NS::VtValue> StageReaderWriterUsd::getArrayAttributeArrayRd(const PrimBucketList& primBucketList,
                                                                                   size_t primBucketListIndex,
                                                                                   Token attrName)
{
    // Get the number of prims in the bucket
    size_t primCount = m_interfaceUsd->getBucketPrimCount(m_stageReaderWriter,
                                                          primBucketList.getId(),
                                                          primBucketListIndex);

    // Early out if there are no prims in the bucket
    if (primCount == 0)
        return {};

    std::vector<PXR_NS::VtValue> result(primCount);
    ConstArrayPointersAndSizesWithTypeC span = m_interfaceUsd->getArrayAttributeArrayVtValueRdFabric(m_stageReaderWriter,
                                                                primBucketList.getId(),
                                                                primBucketListIndex,
                                                                attrName,
                                                                Span<PXR_NS::VtValue>{result.data(), result.size()});

    // elementCount is 0 if the attribute does not exist in the bucket. Return an empty vector in that case.
    if (span.elementCount == 0)
        return {};

    // If the attribute exists, elementCount must match primCount
    CARB_ASSERT(span.elementCount == primCount);
    return result;
}

inline std::vector<std::pair<PXR_NS::VtValue, ContentHashType>> StageReaderWriterUsd::getArrayAttributeArrayOrHashRd(
    const PrimBucketList& primBucketList,
    size_t primBucketListIndex,
    const PXR_NS::TfToken& attrName)
{
    // Get the number of prims in the bucket
    size_t primCount = m_interfaceUsd->getBucketPrimCount(m_stageReaderWriter,
                                                              primBucketList.getId(),
                                                              primBucketListIndex);

    // Early out if there are no prims in the bucket
    if (primCount == 0)
        return {};

    std::vector<PXR_NS::VtValue> values(primCount);
    ConstArrayPointersAndSizesWithTypeC span = m_interfaceUsd->getSparseArrayAttributeArrayVtValueRd(m_stageReaderWriter,
                                                 primBucketList.getId(),
                                                 primBucketListIndex,
                                                 attrName,
                                                 Span<PXR_NS::VtValue>{values.data(), values.size()});

    // elementCount is 0 if the attribute does not exist in the bucket. Return an empty vector in that case.
    if (span.elementCount == 0)
        return {};

    // If the attribute exists, elementCount must match primCount
    CARB_ASSERT(span.elementCount == primCount);

    Span<const ContentHashType> hashes = m_interfaceUsd->getArrayAttributeContentHashes(
        m_stageReaderWriter, primBucketList.getId(), primBucketListIndex, attrName);

    std::vector<std::pair<PXR_NS::VtValue, ContentHashType>> arrays(primCount);

    size_t hashCount = hashes.size();
    for (size_t i = 0; i != hashCount; i++)
    {
        arrays[i].first = values[i];
        arrays[i].second = hashes[i];
    }
    for (size_t i = hashCount; i != primCount; i++)
    {
        arrays[i].first = values[i];
        arrays[i].second = {};
    }

    return arrays;
}

