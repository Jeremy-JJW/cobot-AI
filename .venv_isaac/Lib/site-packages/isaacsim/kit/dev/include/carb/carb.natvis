    <Type Name="carb::extras::HandleDatabase&lt;*,*,*,*,*&gt;">
        <Intrinsic Name="at" Expression="*(HandleData**)&amp;m_bucket[Index]">
            <Parameter Name="Index" Type="size_t"/>
        </Intrinsic>
        <Intrinsic Name="meta" Expression="*(uint64_t*)&amp;HData->metadata">
            <Parameter Name="HData" Type="HandleData*"/>
        </Intrinsic>
        <Intrinsic Name="refs" Expression="meta(HData) &amp; 0xffffffff">
            <Parameter Name="HData" Type="HandleData*"/>
        </Intrinsic>
        <Intrinsic Name="lifecycle" Expression="(meta(HData) &amp; 0xffffffff00000000) &gt;&gt; 32">
            <Parameter Name="HData" Type="HandleData*"/>
        </Intrinsic>
        <Intrinsic Name="indexBits" Expression="(uint32_t)$T4" /> <!-- kIndexBits -->
        <Intrinsic Name="lifecycleBits" Expression="(uint32_t)$T5" /> <!-- kLifecycleBits -->
        <Intrinsic Name="firstBucketPop" Expression="16" /> <!-- kFirstBucketPop -->
        <Intrinsic Name="firstBucketBits" Expression="4" /> <!-- _kFirstBucketBits -->
        <Intrinsic Name="buckets" Expression="indexBits() - firstBucketBits() + 1" /> <!-- kBuckets -->
        <Intrinsic Name="rolloverFlag" Expression="uint32_t(1) &lt;&lt; (lifecycleBits() - 1)" /> <!-- kRolloverFlag -->
        <Intrinsic Name="lifecycleMask" Expression="rolloverFlag() - 1" /> <!-- kLifecycleMask -->
        <Intrinsic Name="bucketSize" Expression="bucket == 0 ? firstBucketPop() : 1u &lt;&lt; (bucket + firstBucketBits() - 1)">
            <Parameter Name="bucket" Type="uint32_t" />
        </Intrinsic>
        <Intrinsic Name="makeHandle" Expression="uint64_t(Index) | (uint64_t(Lifecycle &amp; lifecycleMask()) &lt;&lt; indexBits())">
            <Parameter Name="Index" Type="uint32_t" />
            <Parameter Name="Lifecycle" Type="uint32_t" />
        </Intrinsic>
        <DisplayString>{{ HandleDatabase }}</DisplayString>
        <Expand>
            <CustomListItems MaxItemsPerView="100">
                <Variable Name="Iter" InitialValue="0"/>
                <Variable Name="Max" InitialValue="1"/>
                <Variable Name="Inner" InitialValue="0"/>
                <Variable Name="Index" InitialValue="0"/>
                <Variable Name="HD" InitialValue="(HandleData*)0"/>
                <Loop Condition="Iter &lt; buckets()">
                    <Break Condition="!at(Iter)"/>
                    <Exec>Inner = 0</Exec>
                    <Exec>Max = bucketSize(Iter)</Exec>
                    <Exec>Index = Iter == 0 ? 0 : Max</Exec>
                    <Loop>
                        <Break Condition="Inner &gt;= Max"/>
                        <Exec>HD = &amp;(at(Iter)[Inner])</Exec>
                        <If Condition="refs(HD) != 0">
                            <Item Name="{(size_t)makeHandle(Index + Inner, lifecycle(HD)),x}">*HD</Item>
                        </If>
                        <Exec>Inner++</Exec>
                    </Loop>
                    <Exec>Iter++</Exec>
                </Loop>
            </CustomListItems>
        </Expand>
    </Type>

    <Type Name="carb::extras::HandleDatabase&lt;*,*,*,*,*&gt;::HandleData">
        <Intrinsic Name="meta" Expression="*(uint64_t*)&amp;metadata" />
        <Intrinsic Name="refs" Expression="meta() &amp; 0xffffffff" />
        <DisplayString Condition="!!refs()">{{ {val} }}</DisplayString>
        <DisplayString>{{ free entry }}</DisplayString>
        <Expand>
            <Item Name="[refcount]">refs()</Item>
            <Item Condition="!!refs()" Name="[value]">&amp;val</Item>
        </Expand>
    </Type>

    <Type Name="carb::tasking::ThreadLocalHandleDatabase&lt;*,*&gt;">
        <Intrinsic Name="at" Expression="*(SlabArray**)&amp;m_slabs[Index]">
            <Parameter Name="Index" Type="size_t"/>
        </Intrinsic>
        <Intrinsic Name="meta" Expression="*(uint64_t*)&amp;HData->metadata">
            <Parameter Name="HData" Type="HandleData*"/>
        </Intrinsic>
        <Intrinsic Name="refs" Expression="meta(HData) &amp; 0xffffffff">
            <Parameter Name="HData" Type="HandleData*"/>
        </Intrinsic>
        <Intrinsic Name="lifecycle" Expression="meta(HData) &amp; 0xffffffff00000000">
            <Parameter Name="HData" Type="HandleData*"/>
        </Intrinsic>
        <Intrinsic Name="buckets" Expression="kBuckets" />
        <Intrinsic Name="numDataPerSlab" Expression="512" /> <!-- from kNumDataPerSlab -->
        <DisplayString>{{ ThreadLocalHandleDatabase }}</DisplayString>
        <Expand>
            <CustomListItems MaxItemsPerView="100">
                <Variable Name="Iter" InitialValue="0"/>
                <Variable Name="Max" InitialValue="1"/>
                <Variable Name="Inner" InitialValue="0"/>
                <Variable Name="Index" InitialValue="0"/>
                <Variable Name="Slab" InitialValue="(Slab*)0"/>
                <Variable Name="HD" InitialValue="(HandleData*)0"/>
                <Loop Condition="Iter &lt; buckets()">
                    <Break Condition="!at(Iter)"/>
                    <Exec>Inner = 0</Exec>
                    <Loop>
                        <Break Condition="Inner &gt;= Max"/>
                        <Exec>Slab = (at(Iter)[Inner])</Exec>
                        <If Condition="Slab != nullptr">
                            <Exec>Index = 0</Exec>
                            <Loop Condition="Index &lt; numDataPerSlab()">
                                <Exec>HD = &amp;(Slab-&gt;data[Index])</Exec>
                                <If Condition="refs(HD) != 0">
                                    <Item Name="{(size_t)(lifecycle(HD) + (((Max - 1) + Inner) * numDataPerSlab()) + Index)}">*HD</Item>
                                </If>
                                <Exec>Index++</Exec>
                            </Loop>
                        </If>
                        <Exec>Inner++</Exec>
                    </Loop>
                    <Exec>Max *= 2</Exec>
                    <Exec>Iter++</Exec>
                </Loop>
            </CustomListItems>
        </Expand>
    </Type>

    <!-- Same as carb::extras::HandleDatabase<*,*>::HandleData -->
    <Type Name="carb::tasking::ThreadLocalHandleDatabase&lt;*,*&gt;::HandleData">
        <Intrinsic Name="meta" Expression="*(uint64_t*)&amp;metadata" />
