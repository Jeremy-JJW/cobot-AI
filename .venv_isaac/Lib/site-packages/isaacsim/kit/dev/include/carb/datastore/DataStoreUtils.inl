// non-stable ABI - helpers


// Indicates to the storage backend the timescale at which this data can be regenerated
// This can be incorporated into garbage collection decisions
enum class GenerationTime
{
    None = 0,
    Milliseconds,
    Milliseconds100,
    Seconds,
    Seconds10,
    Minutes,
    Minutes10,
    Hours,
    Count,
};

// Indicates to the storage backend the users priority to persist this data
// This can be incorporated into garbage collection decisions
// Not sure if this is useful in addition to GenerationTime and what kind of heuristic a backend would use to
// incorporate this. Maybe there are better options, but this was discussed in the past.
enum class PersistencePriority
{
    None,
    Low,
    Medium,
    High,
    Count
};

struct SetOptionsFlags
{
    union
    {
        struct  
        {
            uint64_t timeOut : 16;
            uint64_t local : 1;
            uint64_t cluster : 1;
            uint64_t remote : 1;
            uint64_t localConsistent : 1;
            uint64_t clusterConsistent : 1;
            uint64_t remoteConsistent : 1;
            uint64_t generationTime : 4;
            uint64_t persistence : 4;
        };
        uint64_t value;
    };
};

struct SetOptionsBuilder
{
    SetOptionsFlags options;

    inline SetOptionsBuilder()
    {
        options.value = 0;
        setTimeOutUS();
        setLevel();
        setConsistency();
        setGarbageCollectionHints();
    }
    inline SetOptionsBuilder(const SetOptions& options_)
    {
        options.value = options_.options;
    }

    inline SetOptionsBuilder setTimeOutUS(uint32_t timeOut = kTimeOutInfinite)
    {
        options.timeOut = timeOut == kTimeOutInfinite ? 0xffff : std::min(uint32_t(0xfffe), timeOut);
        return *this;
    }
    inline SetOptionsBuilder setLevel(bool local = true, bool cluster = true, bool remote = true)
    {
        options.local = local ? 1 : 0;
        options.cluster = cluster ? 1 : 0;
        options.remote = remote ? 1 : 0;
        return *this;
    }
    inline SetOptionsBuilder setConsistency(bool local = true, bool cluster = true, bool remote = true)
    {
        options.localConsistent = local ? 1 : 0;
        options.clusterConsistent = cluster ? 1 : 0;
        options.remoteConsistent = remote ? 1 : 0;
        return *this;
    }
    inline SetOptionsBuilder setGarbageCollectionHints(GenerationTime timeToGenerate = GenerationTime::None, PersistencePriority persistencePriority = PersistencePriority::None)
    {
        options.generationTime = uint64_t(timeToGenerate);
        options.persistence = uint64_t(persistencePriority);
        return *this;
    }

    inline operator SetOptions() const { return { this->options.value }; }
};

struct GetOptionsFlags
{
    union
    {
        struct
        {
            uint64_t timeOut : 16;
            uint64_t local : 1;
            uint64_t cluster : 1;
            uint64_t remote : 1;
            uint64_t existence : 1;
            uint64_t size : 1;
            uint64_t data : 1;
        };
        uint64_t value;
    };
};

struct GetOptionsBuilder
{
    GetOptionsFlags options;

    inline GetOptionsBuilder()
    {
        options.value = 0;
        setTimeOutUS();
        setLevel();
        setResult();
    }
    inline GetOptionsBuilder(const GetOptions& options_)
    {
        options.value = options_.options;
    }
    inline GetOptionsBuilder setTimeOutUS(uint32_t timeOut = kTimeOutInfinite)
    {
        options.timeOut = timeOut == kTimeOutInfinite ? 0xffff : std::min(uint32_t(0xfffe), timeOut);
        return *this;
    }
    inline GetOptionsBuilder setLevel(bool local = true, bool cluster = true, bool remote = true)
    {
        options.local = local ? 1 : 0;
        options.cluster = cluster ? 1 : 0;
        options.remote = remote ? 1 : 0;
        return *this;
    }
    inline GetOptionsBuilder setResult(bool existence = true, bool size = true, bool data = true)
    {
        options.existence = existence ? 1 : 0;
        options.size = size ? 1 : 0;
        options.data = data ? 1 : 0;
        return *this;
    }

    inline operator GetOptions() const { return { this->options.value }; }
};

// convenience helper
inline omni::utils::OperationResult copyDataBlock(
    IDataStore& store,
    const StorageContext& storageContext,
    const HashKey& key,
    std::vector<uint8_t>& dataBlock,
    const GetOptions& options = GetOptionsBuilder())
{
    struct CBContext
    {
        std::vector<uint8_t>& data;
        omni::utils::OperationResult result;
    }cbContext{ dataBlock, omni::utils::OperationResult::FAILURE };
    store.get(storageContext, options, &key, 1, nullptr, [](void* context, const GetCallbackResult& results)
        {
            CBContext* cbContext = (CBContext*)context;
            if ((results.result == omni::utils::OperationResult::SUCCESS) && results.keyCount)
            {
                cbContext->result = results.result;
                cbContext->data.resize(results.sizesInBytes[0]);
                memcpy(cbContext->data.data(), results.dataBlocks[0], results.sizesInBytes[0]);
            }
            else
            {
                cbContext->result = results.result;
            }

        }, &cbContext );
    return cbContext.result;
}

inline omni::utils::OperationResult retrieveDataBlock(
    IDataStore& store,
    const StorageContext& storageContext,
    const HashKey& key,
    uint8_t* data,
    size_t& inOutDataSize,
    const GetOptions& options = GetOptionsBuilder())
{
    struct CBContext
    {
        size_t& inOutDataSize;
        omni::utils::OperationResult result;
    }cbContext{ inOutDataSize, omni::utils::OperationResult::FAILURE };
    StorageDesc storageDesc{ data, inOutDataSize };
    store.get(storageContext, options, &key, 1, &storageDesc, [](void* context, const GetCallbackResult& results)
        {
            CBContext* cbContext = (CBContext*)context;
            if ((results.result == omni::utils::OperationResult::SUCCESS) && results.keyCount)
            {
                cbContext->result = results.result;
                cbContext->inOutDataSize = results.sizesInBytes[0];
            }
            else
            {
                cbContext->result = results.result;
            }

        }, &cbContext );
    return cbContext.result;
}

inline omni::utils::OperationResult retrieveDataBlockSize(
    IDataStore& store,
    const StorageContext& storageContext,
    const HashKey& key,
    size_t& inOutDataSize,
    const GetOptions& options = GetOptionsBuilder())
{
    struct CBContext
    {
        size_t& inOutDataSize;
        omni::utils::OperationResult result;
    }cbContext{ inOutDataSize, omni::utils::OperationResult::FAILURE };
    GetOptionsBuilder sizeOptions(options);
    sizeOptions.setResult(false, true, false);
    store.get(storageContext, sizeOptions, &key, 1, nullptr, [](void* context, const GetCallbackResult& results)
        {
            CBContext* cbContext = (CBContext*)context;
            if ((results.result == OperationResult::SUCCESS) && results.keyCount)
            {
                cbContext->result = results.result;
                cbContext->inOutDataSize = results.sizesInBytes[0];
            }
            else
            {
                cbContext->result = results.result;
            }

        }, &cbContext );
    return cbContext.result;
}

inline omni::utils::OperationResult storeDataBlock(IDataStore& store, const StorageContext& storageContext, const uint8_t* data, size_t size, HashKey& outHashKey, const SetOptions& options = SetOptionsBuilder())
{
    return store.set(storageContext, options, 1, &data, &size, &outHashKey, nullptr, nullptr);
}

inline omni::utils::OperationResult storeDataBlockWithKey(
    IDataStore& store,
    const StorageContext& storageContext,
    const HashKey& key,
    const uint8_t* data,
    size_t size,
    const SetOptions& options = SetOptionsBuilder())
{
    return store.setWithKey(storageContext, options, &key, 1, &data, &size, nullptr, nullptr);
}

inline StorageContext getDefaultStorageContext(const char* desc = nullptr)
{
    return { {}, desc };
}

struct SetOptionsDecoder
{
    SetOptionsFlags flags;

    SetOptionsDecoder(const SetOptions& options)
    {
        flags.value = options.options;
    }

    bool getLocalEnabled() const { return flags.local; }
    bool getRemoteEnabled() const { return flags.remote; }
    bool getRemoteConsistent() const { return flags.remoteConsistent; }
    bool getClusterEnabled() const { return flags.cluster; }
    bool getClusterConsistent() const { return flags.clusterConsistent; }
    GenerationTime getGenerationTime() const { return (GenerationTime)flags.generationTime; }
};

struct GetOptionsDecoder
{
    GetOptionsFlags flags;

    GetOptionsDecoder(const GetOptions& options)
    {
        flags.value = options.options;
    }

    bool getLocalEnabled() const { return flags.local; }
    bool getClusterEnabled() const { return flags.cluster; }
    bool getRemoteEnabled() const { return flags.remote; }

    bool getSize() const { return flags.size; }
    bool getExistence() const { return flags.existence; }
    bool getData() const { return flags.data; }
};

inline GetCallbackResult getResultForIndex(size_t i, const GetCallbackResult& results)
{
    CARB_CHECK(i < results.keyCount);
    return { results.result, results.index + i, 1, results.dataBlocks ? (results.dataBlocks + i) : nullptr,
             results.sizesInBytes ? (results.sizesInBytes + i) : nullptr };
}
inline SetCallbackResult getResultForIndex(size_t i, const SetCallbackResult& results)
{
    CARB_CHECK(i < results.keyCount);
    return { results.result, results.index + i, 1 };
}
inline TouchCallbackResult getResultForIndex(size_t i, const TouchCallbackResult& results)
{
    CARB_CHECK(i < results.keyCount);
    return { results.result, results.index + i, 1 };
}

