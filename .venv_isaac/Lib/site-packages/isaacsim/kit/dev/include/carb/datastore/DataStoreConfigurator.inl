inline DataStoreConfigurator::DataStoreConfigurator(const char* name, const Config& config)
: m_name(name ? name : "<unnamed>")
, m_hsscClientDestroy(config.m_hsscClientDestroy)
{
    createDataStores(config);
}
inline DataStoreConfigurator::~DataStoreConfigurator()
{
    destroyDataStores();
    if (m_hsscClientOpaque && m_hsscClientDestroy)
    {
        m_hsscClientDestroy(m_hsscClientOpaque);
        m_hsscClientOpaque = nullptr;
    }
}

inline bool DataStoreConfigurator::createDataStores(const Config& config)
{
    carb::Framework* framework = carb::getFramework();

    carb::datastore::IDataStore* lowLatencyDataStore = nullptr;

    std::string remoteCacheDir(config.m_remoteCachePath ? config.m_remoteCachePath : "");
    std::string remoteCacheDiscoveryPath(config.m_remoteCacheDiscoveryPath ? config.m_remoteCacheDiscoveryPath : "");
    bool useRemoteCacheDiscovery = config.m_useRemoteCacheDiscoveryForWrites;
    bool canCreateRemoteDataStore = false;
    carb::datastore::INucleusDataStore* iNucleusDS = nullptr;

    // Check if we can create remote data store
    if (config.m_allowNucleusDataStore && (!remoteCacheDir.empty() || !remoteCacheDiscoveryPath.empty()))
    {
        iNucleusDS = framework->tryAcquireInterface<carb::datastore::INucleusDataStore>("carb.datastore.plugin");
        canCreateRemoteDataStore = iNucleusDS != nullptr;
    }

    // First choice: GRPC datastore
    if (config.m_allowGRPCDataStore && config.m_grpcDnsName && strlen(config.m_grpcDnsName) > 0)
    {
        carb::datastore::IGRPCDataStore* iGRPCDataStore = 
            framework->tryAcquireInterface<carb::datastore::IGRPCDataStore>("omni.datastore.ext.plugin");
        if (iGRPCDataStore)
        {
            lowLatencyDataStore = iGRPCDataStore->createEx(config.m_grpcDnsName, config.m_grpcUseTLS);

            if (lowLatencyDataStore)
            {
                CARB_LOG_INFO("DataStoreConfigurator[%s]: created GRPC datastore", m_name);
                m_features = Features(uint32_t(m_features) | uint32_t(Features::HighSpeed) | uint32_t(Features::Network));
            }
        }
        else
        {
            CARB_LOG_WARN("DataStoreConfigurator[%s]: failed to acquire datastore::IGRPCDataStore", m_name);
        }
    }

    // Hssc DataStore - delegated to a caller-supplied factory so this header has no HSSC dependency.
    if (!lowLatencyDataStore && config.m_allowHsscDataStore && config.m_hsscDataStoreFactory)
    {
        lowLatencyDataStore = config.m_hsscDataStoreFactory(config, &m_hsscClientOpaque);
        if (lowLatencyDataStore)
        {
            CARB_LOG_INFO("DataStoreConfigurator[%s]: created HsscDataStore", m_name);

            // HSSC cannot work with remote datastores until we unify the key rectification
            canCreateRemoteDataStore = false;

            m_features = Features(uint32_t(m_features) | uint32_t(Features::HighSpeed) | uint32_t(Features::Network));
        }
    }

    // OmniHub datastore
    if (!lowLatencyDataStore && config.m_allowHubDataStore)
    {
        carb::datastore::IOmniHubDataStore* iOmniHubDataStore =
            framework->tryAcquireInterface<carb::datastore::IOmniHubDataStore>("carb.datastore.plugin");
        carb::datastore::IWriteBackDataStore* iWriteBackDataStore =
            framework->tryAcquireInterface<carb::datastore::IWriteBackDataStore>("carb.datastore.plugin");        
        if (iOmniHubDataStore)
        {
            auto storage = iOmniHubDataStore->create();

            if (storage && iWriteBackDataStore)
            {
                lowLatencyDataStore = iWriteBackDataStore->create(omni::core::steal(storage));
            }
            else
            {
                lowLatencyDataStore = storage;
            }
            
            if (lowLatencyDataStore)
            {
                auto dsType = iWriteBackDataStore ? "OmniHubWriteBack" : "OmniHub";
                CARB_LOG_INFO("DataStoreConfigurator[%s]: created %s datastore", m_name, dsType);

                m_features = Features(uint32_t(m_features) | uint32_t(Features::OmniHub));
            }
        }
    }

    // Last fallback: LocalDataStore
    if (!lowLatencyDataStore && config.m_allowLocalDataStore)
    {
        carb::datastore::ILocalDataStore* iLocalDS =
            framework->tryAcquireInterface<carb::datastore::ILocalDataStore>("carb.datastore.plugin");
        if (!iLocalDS)
        {
            CARB_LOG_WARN("DataStoreConfigurator: failed to acquire ujitso::ILocalDataStore");
            return false;
        }

        std::string localCacheDir(config.m_localCachePath ? config.m_localCachePath : "");
        const size_t memoryLimit = config.m_localMemoryCacheSize;

        lowLatencyDataStore = iLocalDS->create(localCacheDir.c_str(), memoryLimit);
        if (lowLatencyDataStore)
        {
            CARB_LOG_INFO("DataStoreConfigurator[%s]: created local datastore on: '%s'",
                            m_name, localCacheDir.c_str());

            m_features = Features(uint32_t(m_features) | uint32_t(Features::Local));
        }
    }

    // Create remote data store and attach low latency cache
    if (canCreateRemoteDataStore && config.m_allowNucleusDataStore)
    {
        carb::datastore::IDataStore* remoteDataStore = iNucleusDS->create(
            remoteCacheDir.c_str(), remoteCacheDiscoveryPath.empty() ? nullptr : remoteCacheDiscoveryPath.c_str(),
            useRemoteCacheDiscovery, lowLatencyDataStore);

        if (remoteDataStore)
        {
            CARB_LOG_INFO("DataStoreConfigurator[%s]: created a nucleus datastore on: '%s'",
                          m_name, remoteCacheDir.c_str());
            m_dataStore = remoteDataStore;

            m_features = Features(uint32_t(m_features) | uint32_t(Features::Network));
        }
    }
    else
    {
        // If no remote data store, use the low latency directly
        m_dataStore = lowLatencyDataStore;
    }

    if (config.m_profile && m_dataStore)
    {
        // wrap the datastore for profiling
        carb::datastore::IProfileDataStore* iProfileDataStore =
            framework->tryAcquireInterface<carb::datastore::IProfileDataStore>("carb.datastore.plugin");
        if (iProfileDataStore)
        {
            std::string profileLogPath(config.m_profileLogPath);
            if (profileLogPath.empty())
            {
                // If no profileLogPath, get the current carb log file path 
                // add __datastore_profile.csv instead of the existing extension
                static constexpr char kLogFileSettingsPath[] = "/log/file";
                const carb::settings::ISettings* settings = carb::getCachedInterface<carb::settings::ISettings>();
                const carb::extras::Path logFilenamePath(carb::settings::getString(settings, kLogFileSettingsPath));
                const carb::extras::Path profileFilenamePath(logFilenamePath.getParent() / logFilenamePath.getStem() + "_datastore_profile.csv");
                profileLogPath = profileFilenamePath.getString();
                CARB_LOG_VERBOSE("ProfileDataStore: no path given for log file. Using '%s' log file location and '%s' output.",
                                 logFilenamePath.c_str(), profileLogPath.c_str());
            }
            CARB_LOG_INFO("ProfileDataStore: creating a profiler for the datastore logging to: '%s'.",
                          profileLogPath.c_str());
            m_dataStore = iProfileDataStore->create(profileLogPath.c_str(), *m_dataStore);
        }
    }

    // datastore wrapper that allows us to inject failures
    if (config.m_supportFailureInjection && m_dataStore)
    {
        // wrap the datastore for profiling
        carb::datastore::IFailureInjectionDataStoreFactory* iFailureInjectionDataStore =
            framework->tryAcquireInterface<carb::datastore::IFailureInjectionDataStoreFactory>("carb.datastore.plugin");
        if (iFailureInjectionDataStore)
        {
            m_dataStore = iFailureInjectionDataStore->create(*m_dataStore);
            if (m_dataStore)
            {
                m_features = Features(uint32_t(m_features) | uint32_t(Features::FailureInjection));
            }
        }
    }

    return (m_dataStore != nullptr);
}

inline void DataStoreConfigurator::destroyDataStores()
{
    if (m_dataStore)
    {
        m_dataStore->release();
    }
}

inline bool DataStoreConfigurator::supportsOmniHub()
{
    carb::Framework* framework = carb::getFramework();
    carb::datastore::IOmniHubDataStore* iOmniHubDataStore =
        framework->tryAcquireInterface<carb::datastore::IOmniHubDataStore>(
            "carb.datastore.plugin");
    if (!iOmniHubDataStore)
    {
        CARB_LOG_WARN("DataStoreConfigurator : failed to acquire datastore::IOmniHubDataStore. UJITSO disabled");
        return false;
    }
    return iOmniHubDataStore->isSupported();
}

inline carb::datastore::IDataStore* DataStoreConfigurator::getDataStore()
{
    return m_dataStore;
}
inline DataStoreConfigurator::Features DataStoreConfigurator::getFeatures() const
{
    return m_features;
}


