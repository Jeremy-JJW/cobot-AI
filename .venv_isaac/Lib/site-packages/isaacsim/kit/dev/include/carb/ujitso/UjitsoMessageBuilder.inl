#pragma once

#include <iomanip>
#include <sstream>
#include <string>

namespace carb
{
namespace ujitso
{

// Helper to build a ujitso log message in either a structured format (JSON 'lite') or human readable format (similar to YAML)
// - Note that is no validation/transformations of string values passed in
// - Every value passed in will be wrapped in a string
// - Make sure you either correctly scope of call finalize() in order to end sections
struct UjitsoLogMessageBuilder
{
public:
    enum class Format
    {
        HumanReadable,
        JSON,
        PrettyJSON,
    };
    enum class Flags : uint32_t
    {
        None = 0x0,
        IsArray = 0x1, // creates array types
        Compact = 0x2, // output on the same line
    };
    inline bool isFlagSet(Flags lhs, Flags rhs)
    {
        return (uint32_t(lhs) & uint32_t(rhs)) == uint32_t(rhs);
    }

    explicit UjitsoLogMessageBuilder(Format format, std::stringstream& message, int indentLevel = 0)
    : m_format(format),
      m_message(message),
      m_indentLevel(indentLevel)
    {
        if (m_format == Format::JSON || m_format == Format::PrettyJSON)
        {
            m_message << "{";
        }
    }

    UjitsoLogMessageBuilder(UjitsoLogMessageBuilder& parent, const std::string& key, Flags flags = Flags::None)
    : m_format(parent.m_format),
      m_message(parent.m_message),
      m_indentLevel(parent.m_indentLevel),
      m_flags(flags)
    {
        const bool addKey = (!isFlagSet(parent.m_flags, Flags::IsArray) || m_format == Format::HumanReadable);
        addSeparator(parent.m_isFirst, addKey, true);

        if (addKey)
        {
            appendKey(key);
        }

        if (m_format == Format::JSON || m_format == Format::PrettyJSON)
        {
            const bool isArray = isFlagSet(m_flags, Flags::IsArray);
            if (m_format == Format::PrettyJSON)
            {
                if(addKey && !isArray)
                {
                   m_message << indent(m_indentLevel);
                }
            }
            m_message << (isArray ? "[" : "{");
        }

        if (m_format == Format::PrettyJSON || m_format == Format::HumanReadable)
        {
            m_indentLevel++;
        }

        parent.m_isFirst = false;
    }

    // Destructor for closing nested objects when going out of scope
    ~UjitsoLogMessageBuilder()
    {
        addEnd();
    }

    // lambda wrapper we can pass as "value" to add*() so we can write complex values diretly to the stream
    template <typename Lambda>
    struct LambdaValue
    {
        LambdaValue(Lambda lambda) : m_lambda(lambda)
        {}
        Lambda m_lambda;
    };

    template <typename T>
    UjitsoLogMessageBuilder& add(const std::string& key, const T& value)
    {
        if (isFlagSet(m_flags, Flags::IsArray))
        {
            CARB_LOG_ERROR("Cannot add to an array, use addArrayEntry()");
            return *this;
        }

        addSeparator(m_isFirst);

        appendKey(key);

        writeValue(value);

        m_isFirst = false;
        return *this;
    }

    template <typename T>
    UjitsoLogMessageBuilder& addArrayEntry(const T& value)
    {
        if (!isFlagSet(m_flags, Flags::IsArray))
        {
            CARB_LOG_ERROR("Can only add to array");
            return *this;
        }

        addSeparator(m_isFirst);

        if (m_format == Format::HumanReadable)
        {
            m_message << "- ";
        }
        writeValue(value);

        m_isFirst = false;
        return *this;
    }

    std::string finalize()
    {
        addEnd();
        return m_message.str();
    }

private:
    Format m_format = Format::JSON;
    std::stringstream& m_message; // Shared stream reference
    int m_indentLevel = 0;
    Flags m_flags = Flags::None;
    bool m_isFirst = true;
    bool m_finalized = false;

    void addSeparator(bool isFirst, bool hasKey = true, bool isGroup = false)
    {
        const bool isCompact = isFlagSet(m_flags, Flags::Compact);
        if ((m_format == Format::JSON || m_format == Format::PrettyJSON || 
            (m_format == Format::HumanReadable && isCompact) ) && !isFirst)
        {
            m_message << ", ";
        }
        const bool addInitialIndentation = (isGroup || !isCompact);
        if ( (m_format == Format::HumanReadable || m_format == Format::PrettyJSON) && addInitialIndentation)
        {
            m_message << "\n" << indent(m_indentLevel + 1);
        }
    }

    void appendKey(const std::string& key)
    {
        if (m_format == Format::JSON || m_format == Format::PrettyJSON)
        {
            m_message << "\"" << key << "\": ";
        }
        else
        {
            m_message << key << ": ";
        }
    }

    // lambda writing directly to the stream
    template <typename T>
    void writeValue(const LambdaValue<T>& value)
    {
        m_message << "\"";
        value.m_lambda(m_message);
        m_message << "\"";
    }
    // All other values go directly to whatever std::stringstream supports
    template <typename T>
    void writeValue(const T& value)
    {
        m_message << "\"" << value << "\"";
    }

    void addEnd()
    {
        if (!m_finalized)
        {
            if (m_format == Format::JSON || m_format == Format::PrettyJSON)
            {
                const bool isArray = isFlagSet(m_flags, Flags::IsArray);
                const char* terminator = isArray ? "]" : "}";

                const bool compact = isFlagSet(m_flags, Flags::Compact);
                if (m_format == Format::PrettyJSON && !compact && !m_isFirst)
                {
                    m_message << "\n" << indent(m_indentLevel);
                }
                m_message << terminator;
            }

            m_finalized = true;
        }
    }

    std::string indent(int level) const
    {
        static constexpr uint32_t kIndexSizeInSpaces = 4;
        level = (level > 0 ) ? level : 0;
        return std::string(level * kIndexSizeInSpaces, ' ');
    }
};

inline UjitsoLogMessageBuilder::Flags operator|(UjitsoLogMessageBuilder::Flags lhs, UjitsoLogMessageBuilder::Flags rhs)
{
    return static_cast<UjitsoLogMessageBuilder::Flags>(
        static_cast<std::underlying_type_t<UjitsoLogMessageBuilder::Flags>>(lhs) |
        static_cast<std::underlying_type_t<UjitsoLogMessageBuilder::Flags>>(rhs));
}


} // namespace carb
} // namespace ujitso
