// non-stable ABI - helpers

struct OperationResultEx
{
    OperationResult val;

    inline OperationResultEx()
        : val{}
    {        
    }

    inline OperationResultEx(OperationResult val_)
        : val{ val_ }
    {
    }

    // !SUCCESS is defined as true so that one can write
    // if(OperationResultEx result = ...)  handle failure
    constexpr operator bool() const
    {
        return val != OperationResult::SUCCESS;
    }

    constexpr operator OperationResult() const
    {
        return val;
    }
};

inline void dumpRequest(const Request& request, UjitsoLogMessageBuilder& output, const DumpFlags dumpFlags);

template<typename T, uint32_t initialSize>
using InplaceVector = omni::SmallVector<T, initialSize>;

#define PROCESSOR_INFO(processorName, processorversion, batchHint) \
    carb::ujitso::OperationResult getInfoImpl(carb::ujitso::ProcessorInformation& info) \
    { \
        info.name = #processorName; \
        info.version = processorversion; \
        info.remoteExecutionBatchHint = batchHint; \
        return carb::ujitso::OperationResult::SUCCESS; \
    } \

// helper to implement the processor API for a single job build individually
template<typename Derived>
struct ProcessorImpl : Processor
{
    ProcessorImpl()
    {
        this->getInfo = getInfoStatic;
        this->match = matchStatic;
        this->gatherDependencies = gatherDependenciesStatic;
        this->estimateResourceRequirements = estimateResourceRequirementsStatic;
        this->build = buildStatic;
        this->dump = dumpStatic;
    }

    static OperationResult CARB_ABI getInfoStatic(Processor& processor, ProcessorInformation& info)
    {
        return ((Derived&)processor).getInfoImpl(info);
    }

    static OperationResult CARB_ABI matchStatic(MatchContext& context, const Request& request, MatchResult& result)
    {
        return ((Derived&)context.processor).matchImpl(context, request, result);
    }

    // gather the dependencies for a dependencyjob containing requests that matches this processor
    static OperationResult CARB_ABI gatherDependenciesStatic(DependencyContext& context, DependencyJob& job, DependencyHandle dependencyHandle)
    {
        return ((Derived&)context.processor).gatherDependenciesImpl(context, job, dependencyHandle);
    }

    static OperationResult CARB_ABI estimateResourceRequirementsStatic(ResourceContext& context, BuildJob& job, ResourceRequirements& requirements)
    {
        return ((Derived&)context.processor).estimateResourceRequirementsImpl(context, job, requirements);
    }

    // build the results for a build job containing requests that matched this processor
    static OperationResult CARB_ABI buildStatic(BuildContext& context, BuildJob& job, BuildHandle buildHandle)
    {
        return ((Derived&)context.processor).buildImpl(context, job, buildHandle);
    }

    static OperationResult CARB_ABI dumpStatic(RequestDumpingContext& context, const Request& request)
    {
        return ((Derived&)context.processor).dumpImpl(context, request);
    }

    // default implementation
    OperationResult getInfoImpl(ProcessorInformation& info)
    {
        return OperationResult::FAILURE;
    }

    OperationResult matchImpl(MatchContext& context, const Request& request, MatchResult& result)
    {
        result = MatchResult::NormalPriority;
        return OperationResult::SUCCESS;
    }

    OperationResult gatherDependenciesImpl(DependencyContext& context, DependencyJob& job, DependencyHandle dependencyHandle)
    {
        return OperationResult::SUCCESS;
    }

    OperationResult estimateResourceRequirementsImpl(ResourceContext& context, BuildJob& job, ResourceRequirements& requirements)
    {
        return OperationResult::NOT_SUPPORTED;
    }

    OperationResult buildImpl(BuildContext& context, BuildJob& job, BuildHandle buildHandle)
    {
        return OperationResult::SUCCESS;
    }
    OperationResult dumpImpl(RequestDumpingContext& context, const Request& request)
    {
        dumpRequest(request, context.output, context.flags);
        return OperationResult::SUCCESS;
    }
};

