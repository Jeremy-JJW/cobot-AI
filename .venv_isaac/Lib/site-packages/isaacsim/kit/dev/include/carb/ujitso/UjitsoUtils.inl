template<size_t InplaceValueStorage>
OperationResult getExternalData(Agent& agent, const ResultHandle& handle, InplaceVector<ExternalStorage, InplaceValueStorage>& outVectorResult)
{
    uint32_t externalDataSize = outVectorResult.size();
    OperationResult result = agent.agent->getRequestExternalData(handle, externalDataSize ? outVectorResult.data() : nullptr, &externalDataSize);
    if ((result == OperationResult::SUCCESS) && outVectorResult.size())
