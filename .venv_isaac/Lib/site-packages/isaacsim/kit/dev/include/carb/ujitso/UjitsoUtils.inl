template<uint32_t InplaceCount>
struct FetchDependencies
{
    FetchDependencies(Agent& agent, const BuildHandle& handle)
    {
        m_depCount = 0;
        m_result = agent.service->getDependencies(agent, handle, nullptr, &m_depCount);
        if (m_result != OperationResult::SUCCESS)
        {
            return;
        }
        m_deps.resize(m_depCount);
        m_result = agent.service->getDependencies(agent, handle, m_deps.data(), &m_depCount);
    }

    const BuildHandle& getDep(uint32_t index) const 
    {
        CARB_CHECK(index < m_depCount);
        return m_deps[index];
    }

    uint32_t getDepCount() const
    {
        return m_depCount;
    }
    OperationResult getResult() const
    {
        return m_result;
    }
    const InplaceVector<BuildHandle, InplaceCount>& getDeps() const
    {
        return m_deps;
    }
private:
    OperationResult m_result;
    uint32_t m_depCount;
    InplaceVector<BuildHandle, InplaceCount> m_deps;
};


template<typename Callback>
OperationResult forEachDependency(Agent& agent, const BuildHandle& handle, Callback cb)
{
    FetchDependencies<128> deps(agent, handle);
    if (deps.getResult() != OperationResult::SUCCESS)
    {
        return deps.getResult();
    }

    uint32_t idx = 0;
    for (const BuildHandle& dep : deps.getDeps())
    {
        OperationResult result = cb(idx, dep);
        if (result != OperationResult::SUCCESS)
        {
            return result;
        }
        idx++;
    }
    return OperationResult::SUCCESS;
}

inline uint32_t getRequestTokenValueOffset(const RequestType& requestType, uint32_t typeIdx)
{
    CARB_ASSERT(typeIdx <= requestType.count);
    uint32_t offset = 0;
    for (uint32_t i = 0; (i < typeIdx) && (i < requestType.count); i++)
    {
        offset += requestType.types[i].size;
    }
    return offset;
}

// non-recursive version
inline uint64_t fnv1aHashLoop(const char* str, std::size_t n, uint64_t hash = kFnvBasis)
{
    while (n > 0)
    {
        hash = (hash ^ *str) * kFnvPrime;
        n--;
        str++;
    }
    return hash;
}

struct KeyTokenEx : KeyToken
{
    constexpr KeyTokenEx(IRegistry::GlobalKeyToken key)
        : KeyToken{ uint32_t(key) & ~KeyToken::kStaticStringHashMarker }
    {        
    }

    // static compile time
    template <size_t N>
    constexpr KeyTokenEx(const char(&str)[N])
        : KeyToken{ uint32_t(CARB_HASH_STRING(str) | KeyToken::kStaticStringHashMarker) }
    {
    }

    // make a key token at compile time from a static string
    KeyTokenEx(const char* str)
        : KeyToken{ uint32_t(fnv1aHashLoop(str, strlen(str)) | KeyToken::kStaticStringHashMarker) }
    {
    }

    constexpr KeyTokenEx(const KeyToken& token)
        : KeyToken(token)
    {

    }

    inline bool operator==(const KeyTokenEx& token) const
    {
        return this->value == token.value;
    }

    inline bool operator!=(const KeyTokenEx& token) const
    {
        return this->value != token.value;
    }

    inline bool operator==(const KeyToken& token) const
    {
        return this->value == token.value;
    }

    inline bool operator!=(const KeyToken& token) const
    {
        return this->value != token.value;
    }
};

inline bool operator==(const KeyToken& tokenA, const KeyTokenEx& tokenB)
{
    return tokenB.value == tokenA.value;
}

inline bool operator!=(const KeyToken& tokenA, const KeyTokenEx& tokenB)
{
    return tokenB.value != tokenA.value;
}

inline uint32_t getRequestTokenValuesSize(const RequestType& requestType)
{
    uint32_t totalSize = 0;
    for (uint32_t i = 0; i < requestType.count; i++)
    {
        totalSize += requestType.types[i].size;
    }
    return totalSize;
}

template<typename T>
struct RequestTokenTypeHash
{
    static constexpr size_t getHash()
    {
#if CARB_PLATFORM_WINDOWS
        static_assert(false, "Use REGISTER_REQUEST_TOKEN_TYPE to register this type");
#endif //#if CARB_PLATFORM_WINDOWS
        return 0;
    }
};

template<>
struct RequestTokenTypeHash<TokenString>
{
    static constexpr size_t getHash() { return CARB_HASH_STRING("TokenString"); }
};

template<>
struct RequestTokenTypeHash<TokenBuffer>
{
    static constexpr size_t getHash() { return CARB_HASH_STRING("TokenBuffer"); }
};

#define REGISTER_REQUEST_TOKEN_TYPE(__typeName__) \
    namespace carb { namespace ujitso { \
        template<> \
        struct RequestTokenTypeHash<__typeName__> \
        { \
            static constexpr size_t getHash() { return CARB_HASH_STRING(#__typeName__); } \
        }; \
     } } \

template<typename T>
bool isRequestTokenTypeA(const RequestType& requestType, uint32_t typeIdx)
{
    static_assert(!std::is_same<T, TokenString>::value, "Cannot use TokenString with this, use the appropriate function *String* ");
    CARB_ASSERT(typeIdx < requestType.count);
    if (typeIdx >= requestType.count)
    {
        return false;
    }
    if (requestType.types[typeIdx].size != sizeof(T))
    {
        return false;
    }
    constexpr size_t typeHash = RequestTokenTypeHash<T>::getHash();
    static_assert(typeHash != 0, "The type used as a RequestTokenType has not been registered with REGISTER_REQUEST_TOKEN_TYPE");
    if (requestType.types[typeIdx].typeNameHash != uint32_t(typeHash))
    {
        return false;
    }
    return true;
}


inline bool isRequestTokenString(const RequestType& requestType, uint32_t typeIdx)
{
    CARB_ASSERT(typeIdx < requestType.count);
    if (typeIdx >= requestType.count)
    {
        return false;
    }
    if (requestType.types[typeIdx].size == 0)
    {
        // string has always at least the 0
        return false;
    }

    constexpr size_t typeHash = RequestTokenTypeHash<TokenString>::getHash();
    if (requestType.types[typeIdx].typeNameHash != uint32_t(typeHash))
    {
        return false;
    }

    return true;
}

inline bool isRequestTokenBuffer(const RequestType& requestType, uint32_t typeIdx)
{
    CARB_ASSERT(typeIdx < requestType.count);
    if (typeIdx < requestType.count)
    {
        constexpr size_t typeHash = RequestTokenTypeHash<TokenBuffer>::getHash();
        static_assert(typeHash != 0, "The type used as a RequestTokenType has not been registered with REGISTER_REQUEST_TOKEN_TYPE");
        return requestType.types[typeIdx].typeNameHash == uint32_t(typeHash);
    }
    else
    {
        return false;
    }
}

template<typename T>
bool getRequestTokenValue(const RequestType& requestType, uint32_t typeIdx, const uint8_t* values, const T*& outValue)
{
    if (!isRequestTokenTypeA<T>(requestType, typeIdx))
    {
        return false;
    }
    uint32_t offset = getRequestTokenValueOffset(requestType, typeIdx);
    outValue = (const T*)(values + offset);
    return true;
}

template<typename T>
bool getRequestTokenValue(const RequestType& requestType, uint32_t typeIdx, uint8_t* values, T*& outValue)
{
    if (!isRequestTokenTypeA<T>(requestType, typeIdx))
    {
        return false;
    }
    uint32_t offset = getRequestTokenValueOffset(requestType, typeIdx);
    outValue = (T*)(values + offset);
    return true;
}

template<typename T>
bool getRequestTokenValueConst(const RequestType& requestType, uint32_t typeIdx, const uint8_t* values, const T*& outValue)
{
    if (!isRequestTokenTypeA<T>(requestType, typeIdx))
    {
        return false;
    }
    uint32_t offset = getRequestTokenValueOffset(requestType, typeIdx);
    outValue = (const T*)(values + offset);
    return true;
}

inline bool getRequestTokenValueStringConst(const RequestType& requestType, uint32_t typeIdx, const uint8_t* values, TokenString& outValue)
{
    if (!isRequestTokenString(requestType, typeIdx))
    {
        return false;
    }

    uint32_t offset = getRequestTokenValueOffset(requestType, typeIdx);
    outValue.value = (const char*)(values + offset);
    outValue.length = requestType.types[typeIdx].size - 1;
    return true;
}

template<typename T>
const T& getRequestTokenValueDefault(const RequestType& requestType, uint32_t typeIdx, const uint8_t* values, const T& defaultValue)
{
    if (!isRequestTokenTypeA<T>(requestType, typeIdx))
    {
        return defaultValue;
    }
    uint32_t offset = getRequestTokenValueOffset(requestType, typeIdx);
    return *(const T*)(values + offset);
}

inline TokenString getRequestTokenValueStringDefault(const RequestType& requestType, uint32_t typeIdx, const uint8_t* values, const TokenString& defaultValue)
{
    if (!isRequestTokenString(requestType, typeIdx))
    {
        return defaultValue;
    }
    uint32_t offset = getRequestTokenValueOffset(requestType, typeIdx);
    return { (const char*)(values + offset), requestType.types[typeIdx].size - 1 };
}

inline TokenBuffer getRequestTokenValueBufferDefault(const RequestType& requestType, uint32_t typeIdx, const uint8_t* values, const TokenBuffer& defaultValue)
{
    if (!isRequestTokenBuffer(requestType, typeIdx))
    {
        return defaultValue;
    }
    uint32_t offset = getRequestTokenValueOffset(requestType, typeIdx);
    TokenBuffer buffer = {};
    buffer.value = (const uint8_t*)(values + offset);
    buffer.size = requestType.types[typeIdx].size;
    return buffer;
}

template<typename T>
RequestTokenType makeRequestTokenType()
{
    return { sizeof(T), uint32_t(RequestTokenTypeHash<T>::getHash()) };
}

inline RequestTokenType makeVoidRequestTokenType()
{
    return { 0, 0 };
}

inline uint32_t findRequestTokenTypeIdx(const RequestType& requestType, const KeyToken& key, uint32_t& outTypeIdx)
{
    for (uint32_t i = 0; i < requestType.count; ++i)
    {
        if (requestType.keys[i] == key)
        {
            outTypeIdx = i;
            return true;
        }
    }
    return false;
}

template<size_t InplaceValueStorage = 256>
struct DynamicRequest
{
    InplaceVector<KeyToken, 8> m_keys;
    InplaceVector<RequestTokenType, 8> m_types;
    InplaceVector<uint8_t, InplaceValueStorage> m_values;

    DynamicRequest() = default;

    template<typename T>
    DynamicRequest(const KeyTokenEx& key, const T& value)
    {
        add(key, value);
    }

    template<typename T>
    DynamicRequest(const std::vector<std::pair<KeyToken, T>>& pairs)
    {
        static_assert(std::is_trivially_copyable<T>::value, "Only pod types can be stored in requests");
        m_keys.reserve(pairs.size());
        m_types.reserve(pairs.size());
        m_values.reserve(pairs.size());
        for (const auto& keyValue : pairs)
        {
            add(keyValue.first, keyValue.second);
        }
    }

    DynamicRequest(const Request& request)
    {
        if (request.type.count)
        {
            m_keys.resize(request.type.count);
            memcpy(m_keys.data(), request.type.keys, sizeof(*request.type.keys) * request.type.count);
            m_types.resize(request.type.count);
            memcpy(m_types.data(), request.type.types, sizeof(*request.type.types) * request.type.count);
            uint32_t totalSize = getRequestTokenValuesSize(request.type);
            m_values.resize(totalSize);
            memcpy(m_values.data(), (const uint8_t*)request.tokenValues, totalSize);
        }
    }

    DynamicRequest(const Request& request, const std::vector<KeyTokenEx>& filter)
    {
        m_keys.reserve(uint32_t(filter.size()));
        m_types.reserve(uint32_t(filter.size()));
        m_values.reserve(uint32_t(filter.size()));
        const uint8_t* valuePtr = reinterpret_cast<const uint8_t*>(request.tokenValues);
        for (uint32_t idx = 0; idx < request.type.count; idx++)
        {
            for (KeyToken filterKey : filter)
            {
                if (filterKey == request.type.keys[idx])
                {
                    m_keys.push_back(filterKey);
                    m_types.push_back(request.type.types[idx]);
                    uint32_t oldSize = m_values.size();                    
                    m_values.resize(oldSize + m_types.back().size);
                    memcpy(&m_values[oldSize], valuePtr, m_types.back().size);
                    break;
                }
            }
            valuePtr += request.type.types[idx].size;
        }
    }

    // replaces the key while keeping the type and value
    bool replaceKey(const KeyTokenEx& keyOld, const KeyTokenEx& keyNew)
    {
        bool found = false;
        for (KeyToken& key : m_keys)
        {
            if (key.value == keyOld.value)
            {
                key = keyNew;
                found = true;
            }
        }
        return found;
    }

    // replaces the value of an existing key
    template<typename T>
    bool replaceValue(const KeyTokenEx& key, const T& value)
    {
        static_assert(std::is_trivially_copyable<T>::value, "Only pod types can be stored in requests");

        // for now remove and add
        // TODO : optimize at least when the type size matches
        bool found = removeKey(key);
        add(key, value);
        return found;
    }

    // adds a typed key value pair
    size_t add(const KeyTokenEx& key)
    {
        uint32_t idx = m_keys.size();
        m_keys.push_back(key);
        m_types.push_back(makeVoidRequestTokenType());
        return idx;
    }

    // adds a typed key value pair
    template<typename T>
    size_t add(const KeyTokenEx& key, const T& value)
    {
        static_assert(std::is_trivially_copyable<T>::value, "Only pod types can be stored in requests");
        static_assert(!std::is_pointer<T>::value, "Pointers not supported");

        uint32_t idx = m_keys.size();
        m_keys.push_back(key);
        m_types.push_back(makeRequestTokenType<T>());

        uint32_t current = m_values.size();
        m_values.resize(m_values.size() + sizeof(T));
        memcpy(m_values.data() + current, &value, sizeof(T));
        return idx;
    }

    size_t add(const KeyTokenEx& key, const char* value)
    {
        size_t len = value ? strlen(value) : 0;
        if (len >= size_t(1) << 32)
        {
            CARB_LOG_ERROR("UJITSO : Failed to push string (length:%zu) longer than 4GB onto request", len);
            return m_keys.size();
        }

        uint32_t idx = m_keys.size();
        m_keys.push_back(key);
        RequestTokenType type = makeRequestTokenType<TokenString>();
        type.size = uint32_t(len + 1);
        m_types.push_back(type);

        uint32_t current = m_values.size();
        m_values.resize(m_values.size() + type.size);
        if (value)
        {
            memcpy(m_values.data() + current, value, type.size);
        }
        else
        {
            *(m_values.data() + current) = 0;
        }
        return idx;
    }

    size_t add(const KeyTokenEx& key, const RequestTokenType& type, const uint8_t* value)
    {
        uint32_t idx = m_keys.size();
        m_keys.push_back(key);
        m_types.push_back(type);

        uint32_t current = m_values.size();
        m_values.resize(m_values.size() + type.size);
        memcpy(m_values.data() + current, value, type.size);
        return idx;
    }

    size_t add(const KeyTokenEx& key, const uint8_t* value, size_t len)
    {
        if (len >= CARB_UINT32_MAX)
        {
            CARB_LOG_ERROR("UJITSO : Failed to push byte buffer (length:%zu) longer than 4GB onto request", len);
            return m_keys.size();
        }
        RequestTokenType type = makeRequestTokenType<TokenBuffer>();
        type.size = uint32_t(len);
        return add(key, type, value);
    }

    template<size_t OtherInplaceValueStorage>
    bool copy(const KeyTokenEx& key, const DynamicRequest<OtherInplaceValueStorage>& other)
    {
        bool found = false;
        uint32_t otherOffset = 0;
        for (uint32_t i = 0; i < other.m_keys.size(); i++)
        {
            if (other.m_keys[i].value == key.value)
            {
                add(key, other.m_types[i], other.m_values.data() + otherOffset);
                found = true;
            }
            otherOffset += other.m_types[i].size;
        }
        return found;
    }

    bool removeKey(const KeyTokenEx& key)
    {
        bool found = false;
        uint32_t offset = 0;
        for (uint32_t i = 0; i < m_keys.size(); i++)
        {
            if (m_keys[i].value == key.value)
            {
                if (m_types[i].size > 0)
                {
                    memmove(m_values.data() + offset, m_values.data() + offset + m_types[i].size, m_values.size() - offset - m_types[i].size);
                    m_values.resize(m_values.size() - m_types[i].size);
                }
                m_keys.erase(m_keys.begin() + i);
                m_types.erase(m_types.begin() + i);

                found = true;
                i--;
            }
            else
            {
                offset += m_types[i].size;
            }
        }
        return found;
    }

    bool findKey(const KeyTokenEx& key, RequestTokenType& type) const
    {
        for (uint32_t i = 0; i < m_keys.size(); i++)
        {
            if (m_keys[i].value == key.value)
            {
                type = m_types[i];
                return true;
            }
        }
        return false;
    }

    bool findKey(const KeyTokenEx& key) const
    {
        RequestTokenType unused;
        return findKey(key, unused);
    }


    template<typename T>
    bool getAs(const KeyTokenEx& key, const T*& outValue) const
    {
        for (uint32_t i = 0; i < m_keys.size(); i++)
        {
            if (m_keys[i].value == key.value)
            {
                if (getRequestTokenValueConst({ m_keys.size(), m_keys.data(), m_types.data() }, i, m_values.data(), outValue))
                {
                    return true;
                }
            }
        }
        return false;
    }

    bool getAs(const KeyTokenEx& key, TokenString& outValue) const
    {
        for (uint32_t i = 0; i < m_keys.size(); i++)
        {
            if (m_keys[i].value == key.value)
            {
                if (getRequestTokenValueStringConst({ m_keys.size(), m_keys.data(), m_types.data() }, i, m_values.data(), outValue))
                {
                    return true;
                }
            }
        }
        return false;
    }

    template<typename T>
    const T& getAsDefault(const KeyTokenEx& key, const T& defaultValue) const
    {
        for (uint32_t i = 0; i < m_keys.size(); i++)
        {
            if (m_keys[i].value == key.value)
            {
                return getRequestTokenValueDefault({ m_keys.size(), m_keys.data(), m_types.data() }, i, m_values.data(), defaultValue);
            }
        }
        return defaultValue;
    }

    TokenString getAsStringDefault(const KeyTokenEx& key, const TokenString& defaultValue) const
    {
        for (uint32_t i = 0; i < m_keys.size(); i++)
        {
            if (m_keys[i].value == key.value)
            {
                return getRequestTokenValueStringDefault({ m_keys.size(), m_keys.data(), m_types.data() }, i, m_values.data(), defaultValue);
            }
        }
        return defaultValue;
    }

    TokenBuffer getAsBufferDefault(const KeyTokenEx& key, const TokenBuffer& defaultValue) const
    {
        for (uint32_t i = 0; i < m_keys.size(); i++)
        {
            if (m_keys[i].value == key.value)
            {
                return getRequestTokenValueBufferDefault({ m_keys.size(), m_keys.data(), m_types.data() }, i, m_values.data(), defaultValue);
            }
        }
        return defaultValue;
    }

    KeyToken getKey(uint32_t idx) const { return m_keys[idx]; }
    RequestTokenType getType(uint32_t idx) const { return m_types[idx]; }

    uint32_t size() const { return m_keys.size(); }
    void reserve(uint32_t size) { m_keys.reserve(size); m_types.reserve(size); }

    // the DynamicRequest must be valid for as long as the returned Request is used
    Request getRequest() const
    {
        return { {uint32_t(m_keys.size()), m_keys.data(), m_types.data()}, m_values.data() };
    }
};

template<size_t InplaceValueStorage = 256>
struct RequestBuilder
{
    DynamicRequest<InplaceValueStorage> m_request;

    RequestBuilder()
    {
    }

    void add(const KeyTokenEx& token)
    {
        m_request.add(token);
    }

    template<typename T>
    void add(const KeyTokenEx& token, const T& value)
    {
        m_request.add(token, value);
    }

    void add(const KeyTokenEx& token, const char* value)
    {
        m_request.add(token, value);
    }

    void add(const KeyTokenEx& token, const uint8_t* buffer, size_t size)
    {
        m_request.add(token, buffer, size);
    }

    const DynamicRequest<InplaceValueStorage>& getRequest() const { return m_request; }
    DynamicRequest<InplaceValueStorage>& getRequest() { return m_request; }
};

static const uint32_t kInvalidKeyIndex = 0xffffffff;

inline uint32_t getTokenIndex(const Request& request, const KeyTokenEx& key)
{
    for (uint32_t i = 0; i < request.type.count; i++)
    {
        if (request.type.keys[i].value == key.value)
        {
            return i;
        }
    }
    return kInvalidKeyIndex;
}

template<typename T>
inline const T& getRequestValue(const Agent& agent, const Request& request, const KeyTokenEx& key, const T& defaultValue = {})
{
    uint32_t keyIndex = getTokenIndex(request, key);
    if (keyIndex != kInvalidKeyIndex)
    {
        const T* valuePtr;
        if (getRequestTokenValueConst(request.type, keyIndex, (const uint8_t*)request.tokenValues, valuePtr))
        {
            return *valuePtr;
        }
    }
    return defaultValue;
}

inline TokenString getRequestValueTokenString(const Agent& agent, const Request& request, const KeyTokenEx& key, const TokenString defaultValue = {})
{
    uint32_t keyIndex = getTokenIndex(request, key);
    if (keyIndex != kInvalidKeyIndex)
    {
        TokenString stringValue;
        if (getRequestTokenValueStringConst(request.type, keyIndex, (const uint8_t*)request.tokenValues, stringValue))
        {
            return stringValue;
        }
    }
    return defaultValue;
}

inline const char* getRequestValueString(const Agent& agent, const Request& request, const KeyTokenEx& key, const char* defaultValue = nullptr)
{
    uint32_t keyIndex = getTokenIndex(request, key);
    if (keyIndex != kInvalidKeyIndex)
    {
        TokenString stringValue;
        if (getRequestTokenValueStringConst(request.type, keyIndex, (const uint8_t*)request.tokenValues, stringValue))
        {
            return stringValue.value;
        }
    }
    return defaultValue;
}

inline TokenBuffer getRequestValueBuffer(const Agent& agent, const Request& request, const KeyTokenEx& key, TokenBuffer defaultValue = {})
{
    uint32_t keyIndex = getTokenIndex(request, key);
    if (keyIndex != kInvalidKeyIndex)
    {
        return getRequestTokenValueBufferDefault(request.type, keyIndex, (const uint8_t*)request.tokenValues, {});
    }
    return defaultValue;
}

//------------------------------------------------------------------------------------------------------------------------------------
template<typename SerializerT>
bool serializeRequest(SerializerT& serializer, bool loading, Request& request)
{
    uint32_t kVersion = 1;
    serializer.serialize(loading, kVersion);
    serializer.serialize(loading, request.type.count);
    size_t bufferSize = sizeof(KeyToken) * request.type.count;
    serializer.serializeBuffer(loading, request.type.keys, bufferSize);
    bufferSize = sizeof(RequestTokenType) * request.type.count;
    serializer.serializeBuffer(loading, request.type.types, bufferSize);
    size_t valueSize = getRequestTokenValueOffset(request.type, request.type.count);
    serializer.serializeBuffer(loading, request.tokenValues, valueSize);
    return !serializer.hasError();
}

//------------------------------------------------------------------------------------------------------------------------------------
inline OperationResult storeMetaDataDictionary(Agent& agent, const BuildHandle& buildHandle, const Request& metaDataDictionary)
{
    omni::VectorSerializer serializer;
    Request dictCopy = metaDataDictionary;
    serializeRequest(serializer, false, dictCopy);
    return storeMetaData(agent, buildHandle, serializer);
}

//------------------------------------------------------------------------------------------------------------------------------------
template<uint32_t InplaceMemorySize, typename HandleT>
OperationResult getMetaDataDictionary(Agent& agent, const HandleT& handle, DynamicRequest<InplaceMemorySize>& metaDataDictionary)
{
    return deserializeMetaData(agent, handle, [&metaDataDictionary](auto& serializer)
        {
            Request request{};
            if (!serializeRequest(serializer, true, request))
            {
                return OperationResult::FAILURE;
            }
            metaDataDictionary = DynamicRequest<InplaceMemorySize>(request);
            return OperationResult::SUCCESS;
        });
}

// small helper to make sure that the structure used as a parameter doesn't have any uninitialized padding
template<typename T>
struct SafeParam : T
{
    SafeParam()
    {
        memset(static_cast<T*>(this), 0, sizeof(T));
    }

    const T& getParam() const { return *this; }
};

// helper to enforce mandatory input
struct MandatoryInputGetter
{
    bool hasMissingValues = false;
    const char* missingInputName = "<none>";

    template <typename T>
    const T& getRequestValue(const Request& request, const char* key, const T& defaultValue = {})
    {
        if (hasMissingValues) return defaultValue;

        uint32_t keyIndex = getTokenIndex(request, key);
        if (keyIndex != kInvalidKeyIndex)
        {
            const T* valuePtr;
            if (getRequestTokenValueConst(request.type, keyIndex, (const uint8_t*)request.tokenValues, valuePtr))
            {
                return *valuePtr;
            }
        }

        hasMissingValues = true;
        missingInputName = key;
        return defaultValue;
    }

    TokenString getRequestValueTokenString(const Request& request, const char* key)
    {
        if (hasMissingValues) return {};

        uint32_t keyIndex = getTokenIndex(request, key);
        if (keyIndex != kInvalidKeyIndex)
        {
            TokenString stringValue;
            if (getRequestTokenValueStringConst(request.type, keyIndex, (const uint8_t*)request.tokenValues, stringValue))
            {
                return stringValue;
            }
        }

        hasMissingValues = true;
        missingInputName = key;
        return {};
    }

    const char* getRequestValueString(const Request& request, const char* key)
    {
        return getRequestValueTokenString(request, key).value;
    }

    TokenBuffer getRequestValueBuffer(const Request& request, const char* key)
    {
        if (hasMissingValues) return {};

        uint32_t keyIndex = getTokenIndex(request, key);
        if (keyIndex != kInvalidKeyIndex)
        {
            return getRequestTokenValueBufferDefault(request.type, keyIndex, (const uint8_t*)request.tokenValues, {});
        }

        hasMissingValues = true;
        missingInputName = key;
        return {};
    }
};

struct PreloadedStorageHolder
{
    PreloadedStorageHolder(Agent& agent, ResultHandle handle)
    {
        uint32_t storageCount = 0;
        m_opResult = agent.agent->getRequestExternalData(handle, nullptr, &storageCount);
        if ((m_opResult != OperationResult::SUCCESS) || !storageCount)
        {
            return;
        }
        m_storage.resize(storageCount);
        m_opResult = agent.agent->getRequestPreloadedData(handle, 0, storageCount, m_storage.data());
    }

    PreloadedStorageHolder(Agent& agent, BuildHandle handle)
    {
        uint32_t storageCount = 0;
        m_opResult = agent.service->getExternalData(agent, handle, nullptr, &storageCount);
        if ((m_opResult != OperationResult::SUCCESS) || !storageCount)
        {
            return;
        }
        m_storage.resize(storageCount);
        m_opResult = agent.service->getPreloadedData(agent, handle, 0, storageCount, m_storage.data());
    }

    ~PreloadedStorageHolder()
    {
        for (PreloadedStorage& storage : m_storage)
        {
            if (storage.deleteCallback)
            {
                storage.deleteCallback(storage);
            }
        }
    }

    const uint8_t* getData(uint32_t idx) const
    {
        return (idx < m_storage.size()) ? m_storage[idx].data : nullptr;
    }

    size_t getSize(uint32_t idx) const
    {
        return (idx < m_storage.size()) ? m_storage[idx].sizeInBytes : 0;
    }

    size_t getCount() const
    {
        return m_storage.size();
    }

    OperationResult getResult() const
    {
        return m_opResult;
    }

    bool copy(uint32_t idx, std::vector<uint8_t>& data) const
    {
        if (idx >= m_storage.size())
        {
            return false;
        }
        if (m_storage[idx].sizeInBytes)
        {
            data.resize(m_storage[idx].sizeInBytes);
            memcpy(data.data(), m_storage[idx].data, m_storage[idx].sizeInBytes);
        }
        return true;
    }

    InplaceVector<PreloadedStorage, 4> m_storage;
    OperationResult m_opResult = OperationResult::FAILURE;
};

// Helpers for decoding a request into human readable format
inline const char* getGlobalTokenStr(const IRegistry::GlobalKeyToken token)
{
    switch (token)
    {
    case IRegistry::Path: return "Path";
    case IRegistry::Version: return "Version";
    case IRegistry::Time: return "Time";
    case IRegistry::Flags: return "Flags";
    case IRegistry::Param0: return "Param0";
    case IRegistry::Param1: return "Param1";
    case IRegistry::Param2: return "Param2";
    case IRegistry::Param3: return "Param3";
    case IRegistry::Extension: return "Extension";
    default:
        return "<unkown_global_token>";
    }
}

using keyDecodingCallback =
    std::function<void(const uint8_t* dataStart, uint32_t sizeInBytes, std::ostream& outputStream)>;
struct KeyDecoderType
{
    enum Flags { Default = 0x0, NoKeyInfo = 0x1, LargeString = 0x2 };
    KeyDecoderType(const char* name, keyDecodingCallback callback = nullptr, Flags flags = Default)
    : name(name), token(name), callback(callback), flags(flags)
    {}

    KeyDecoderType(IRegistry::GlobalKeyToken globalToken, keyDecodingCallback callback = nullptr, Flags flags = Default)
    : name(getGlobalTokenStr(globalToken)), token(globalToken), callback(callback), flags(flags)
    {}

    const char* name;
    KeyTokenEx token;
    keyDecodingCallback callback;
    Flags flags;
};

struct KeyDecoderList
{
    const KeyDecoderType* decoders;
    uint32_t decoderCount;
};

inline static void byteArrayKeyDecoder(const uint8_t* dataStart, uint32_t sizeInBytes, std::ostream& outputStream)
{
    outputStream << "raw:'";
    uint32_t maxSize = std::min(32u, sizeInBytes);
    for (uint32_t n = 0; n < maxSize; n++)
    {
        outputStream << std::to_string(dataStart[n]) << ' ';
    }
    if (maxSize < sizeInBytes)
    {
        outputStream << " ... ";
    }
    outputStream << "'";
}
inline static void stringKeyDecoder(const uint8_t* dataStart, uint32_t sizeInBytes, std::ostream& outputStream)
{
    // TODO: make sure we only print the given max size, also make sure we cap the max string size so we don't print huge strings
    std::string s(reinterpret_cast<const char*>(dataStart));
    outputStream << "str:'" << s << "'";
}
inline static void uint32KeyDecoder(const uint8_t* dataStart, uint32_t sizeInBytes, std::ostream& outputStream)
{
    CARB_ASSERT(sizeInBytes >= sizeof(uint32_t));
    uint32_t value = *reinterpret_cast<const uint32_t*>(dataStart);
    outputStream << "u32:'" << value << "'";
}
inline static void uint64KeyDecoder(const uint8_t* dataStart, uint32_t sizeInBytes, std::ostream& outputStream)
{
    CARB_ASSERT(sizeInBytes >= sizeof(uint64_t));
    uint64_t value = *reinterpret_cast<const uint64_t*>(dataStart);
    outputStream << "u64:'" << value << "'";
}
inline static void floatKeyDecoder(const uint8_t* dataStart, uint32_t sizeInBytes, std::ostream& outputStream)
{
    CARB_ASSERT(sizeInBytes >= sizeof(float));
    float value = *reinterpret_cast<const float*>(dataStart);
    outputStream << "f32:'" << value << "'";
}
inline static void boolKeyDecoder(const uint8_t* dataStart, uint32_t sizeInBytes, std::ostream& outputStream)
{
    CARB_ASSERT(sizeInBytes >= sizeof(bool));
    bool value = *reinterpret_cast<const bool*>(dataStart);
    outputStream << "bool:'" << value << "'";
}

struct HashPrinterStreamStateRestorer
{
    HashPrinterStreamStateRestorer(std::ostream& outputStream)
    : outputStream(outputStream)
    {
        oldFlags = outputStream.flags();
        oldFill = outputStream.fill();
        oldWidth = outputStream.width();
    }
    ~HashPrinterStreamStateRestorer()
    {
        outputStream.flags(oldFlags);
        outputStream.fill(oldFill);
        outputStream.width(oldWidth);
    }
    std::ostream& outputStream;
    std::ios_base::fmtflags oldFlags;
    char oldFill;
    std::streamsize oldWidth;
};

struct hash128Printer
{
    hash128Printer(const omni::hash128_t& hash) : hash(hash) {}
    omni::hash128_t hash;
};
inline static std::ostream& operator<<(std::ostream& outputStream, const hash128Printer& printer)
{
    HashPrinterStreamStateRestorer sr(outputStream);
    outputStream << std::setfill('0') << std::hex << std::setw(16) << printer.hash.upper << '-' << std::setw(16)
                    << printer.hash.lower << std::dec;
    return outputStream;
}

inline static void hash128KeyDecoder(const uint8_t* dataStart, uint32_t sizeInBytes, std::ostream& outputStream)
{
    CARB_ASSERT(sizeInBytes >= sizeof(omni::hash128_t));
    omni::hash128_t value = *reinterpret_cast<const omni::hash128_t*>(dataStart);
    outputStream << "hash:'" << hash128Printer(value);
}

inline const KeyDecoderType* getDecoderForKey(const KeyDecoderList& decoders, const KeyToken& key)
{
    for (uint32_t i = 0; i < decoders.decoderCount; ++i)
    {
        if (decoders.decoders[i].token.value == key.value)
        {
            return &decoders.decoders[i];
        }
    }
    return nullptr;
}
inline const KeyDecoderType* getDebugDecoderForKey(const KeyToken& key)
{
    using namespace carb::ujitso;
    static constexpr KeyDecoderType::Flags flags = KeyDecoderType::NoKeyInfo;
    static const KeyDecoderType debugDecoders[] = {
        KeyDecoderType("addContainer()", hash128KeyDecoder, flags),
        KeyDecoderType("addInputHash()", byteArrayKeyDecoder, flags),
        KeyDecoderType("addFileSource()", hash128KeyDecoder, flags)
    };
    for (uint32_t i = 0; i < uint32_t(CARB_COUNTOF(debugDecoders)); ++i)
    {
        if (debugDecoders[i].token.value == key.value)
        {
            return &debugDecoders[i];
        }
    }
    return nullptr;
}

// FIXME: this saves into the current directory
inline bool saveLargeStringFile(const char* debugName, uint64_t hash, const uint8_t* data, size_t size)
{
    carb::filesystem::IFileSystem* fs = carb::getCachedInterface<carb::filesystem::IFileSystem>();
    if (!fs)
    {
        return false;
    }

    std::ostringstream filePath;
    filePath << "LargeString_" << debugName << "_" << std::hex << hash << ".txt";

    if (fs->exists(filePath.str().c_str()))
    {
        CARB_LOG_WARN_ONCE("saveLargeStringFile(): already exists: '%s'", filePath.str().c_str());
        return false;
    }

    carb::filesystem::File* f = fs->openFileToWrite(filePath.str().c_str());
    if (!f)
    {
        CARB_LOG_WARN_ONCE("saveLargeStringFile(): failed to open file for writing '%s'", filePath.str().c_str());
        return false;
    }

    fs->writeFileChunk(f, data, size);
    fs->closeFile(f);
    return true;
}

inline void dumpRequest(const Request& request, UjitsoLogMessageBuilder& output,
                        const KeyDecoderList& decoders, const DumpFlags dumpFlags)
{
    const RequestType& requestType = request.type;

    UjitsoLogMessageBuilder keysArray(output, "Keys", UjitsoLogMessageBuilder::Flags::IsArray);

    uint32_t offset = 0;
    for (size_t i = 0; i < requestType.count; ++i)
    {
        const KeyToken& key = requestType.keys[i];
        const RequestTokenType& type = requestType.types[i];
        uint32_t valueSize = type.size;

        const KeyDecoderType* decoder = getDecoderForKey(decoders, key);
        if (!decoder)
        {
            decoder = getDebugDecoderForKey(key);
        }
        keyDecodingCallback decoderCallback = (decoder && decoder->callback) ? decoder->callback : byteArrayKeyDecoder;

        const uint8_t* data = ((const uint8_t*)request.tokenValues) + offset;
        const uint64_t hash = carb::extras::fnv128hash(data, valueSize).d[0];

        // dump large strings to files (with the context hash as the name)
        // if requested as it would be too verbose to output them
        bool savedToFile = false;
        if (decoder && (decoder->flags & KeyDecoderType::LargeString) &&
            (uint32_t(dumpFlags) & uint32_t(DumpFlags::DumpLargeStrings)))
        {
            savedToFile = saveLargeStringFile(decoder->name ? decoder->name : "<unkown>", hash, data, valueSize);
        }

        // use compact mode so we can put all key params in the same line for easier visualization
        UjitsoLogMessageBuilder keysArrayEntry(keysArray, std::string("Entry") + std::to_string(i),
                                               UjitsoLogMessageBuilder::Flags::Compact);

        if (decoder && (decoder->flags & KeyDecoderType::NoKeyInfo) != 0x0)
        {
            keysArrayEntry.add("decoder", decoder->name);
        }
        else
        {
            keysArrayEntry.add("key", key.value);
            if (decoder && decoder->name)
            {
                keysArrayEntry.add("decoder", decoder->name);
            }
            keysArrayEntry.add("type", type.typeNameHash);
        }
        keysArrayEntry.add("valueSize", valueSize);
        keysArrayEntry.add("hash", UjitsoLogMessageBuilder::LambdaValue([&hash](std::stringstream& ss){
            ss << std::hex << hash << std::dec;
        }));

        if (valueSize && decoderCallback)
        {
            keysArrayEntry.add("decodedData", UjitsoLogMessageBuilder::LambdaValue(
             [decoderCallback, &data, &valueSize](std::stringstream& ss) {
                decoderCallback(data, valueSize, ss);
            }));
        }

        offset += valueSize;
    }
}
inline void dumpRequest(const Request& request, UjitsoLogMessageBuilder& output, const DumpFlags dumpFlags)
{
    dumpRequest(request, output, { nullptr, 0 }, dumpFlags);
}

