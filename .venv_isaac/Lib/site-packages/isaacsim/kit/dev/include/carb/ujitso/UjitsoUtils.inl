template<typename T>
T& createMetaData(Agent& agent, const BuildHandle& buildHandle)
{
    void* ptr;
    if (agent.service->allocateMetaDataStorage(agent, buildHandle, sizeof(T), &ptr) != OperationResult::SUCCESS)
    {
        CARB_FAIL_UNLESS(false, "Failed to allocate meta data storage");
    }
    
    return *reinterpret_cast<T*>(ptr);
}

//------------------------------------------------------------------------------------------------------------------------------------
template<typename SerializerT>
OperationResult storeMetaData(Agent& agent, const BuildHandle& buildHandle, const SerializerT& serializer)
{
    CARB_FAIL_UNLESS(serializer.getCurrentPos() < INT_MAX, "Metadata too large");
    void* ptr;
    if (OperationResultEx result = agent.service->allocateMetaDataStorage(agent, buildHandle, uint32_t(serializer.getCurrentPos()), &ptr))
    {
        return result;
    }
    memcpy(ptr, serializer.getData(), serializer.getCurrentPos());

    return OperationResult::SUCCESS;
}

//------------------------------------------------------------------------------------------------------------------------------------
template<typename T>
OperationResult getMetaData(Agent& agent, const BuildHandle& handle, T& outResult)
{
    uint32_t metaDataSize = sizeof(T);
    OperationResult result = agent.service->getMetaData(agent, handle, &outResult, &metaDataSize);
    if (result == OperationResult::SUCCESS)
    {
        result = (metaDataSize == sizeof(T)) ? OperationResult::SUCCESS : OperationResult::INVALIDMETADATA_ERROR;
    }
    return result;
}

//------------------------------------------------------------------------------------------------------------------------------------
template<typename T>
OperationResult getMetaData(Agent& agent, const ResultHandle& handle, T& outResult)
{
    uint32_t metaDataSize = sizeof(T);
    OperationResult result = agent.agent->getRequestMetaData(handle, &outResult, &metaDataSize);
    if (result == OperationResult::SUCCESS)
    {
        result = (metaDataSize == sizeof(T)) ? OperationResult::SUCCESS : OperationResult::INVALIDMETADATA_ERROR;
    }
    return result;
}

//------------------------------------------------------------------------------------------------------------------------------------
template<size_t InplaceValueStorage>
OperationResult copyMetaData(Agent& agent, const ResultHandle& handle, InplaceVector<uint8_t, InplaceValueStorage>& outVectorResult)
{
    uint32_t metaDataSize = outVectorResult.size();
    OperationResult result = agent.agent->getRequestMetaData(handle, metaDataSize ? outVectorResult.data() : nullptr, &metaDataSize);
    if ((result == OperationResult::SUCCESS) && outVectorResult.size())
    {
        outVectorResult.resize(metaDataSize);
        result = OperationResult::SUCCESS;
    }
    else if ((result == OperationResult::OVERFLOW_ERROR) || !outVectorResult.size())
    {
        outVectorResult.resize(metaDataSize);
        result = agent.agent->getRequestMetaData(handle, outVectorResult.data(), &metaDataSize);
    }
    return result;
}

//------------------------------------------------------------------------------------------------------------------------------------
template<size_t InplaceValueStorage>
OperationResult copyMetaData(Agent& agent, const BuildHandle& handle, InplaceVector<uint8_t, InplaceValueStorage>& outVectorResult)
{
    uint32_t metaDataSize = outVectorResult.size();
    OperationResult result = agent.service->getMetaData(agent, handle, metaDataSize ? outVectorResult.data() : nullptr, &metaDataSize);
    if ((result == OperationResult::SUCCESS) && outVectorResult.size())
    {
        outVectorResult.resize(metaDataSize);
        result = OperationResult::SUCCESS;
    }
    else if ((result == OperationResult::OVERFLOW_ERROR) || !outVectorResult.size())
    {
        outVectorResult.resize(metaDataSize);
        result = agent.service->getMetaData(agent, handle, outVectorResult.data(), &metaDataSize);
    }
    return result;
}

//------------------------------------------------------------------------------------------------------------------------------------
// CallbackT : (ExternalSerializer<true>& serializer) -> OperationResult
template<typename HandleT, typename CallbackT>
OperationResult deserializeMetaData(Agent& agent, const HandleT& buildHandle, CallbackT cb)
{
    InplaceVector<uint8_t, 1024> storage;
    if (OperationResultEx result = copyMetaData<1024>(agent, buildHandle, storage))
    {
        return result;
    }
    omni::ExternalSerializer<true> serializer(storage.data(), storage.size());
    return cb(serializer);
}

