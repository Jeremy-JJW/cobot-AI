inline OperationResult storeExternalStorage(Agent& agent, const BuildHandle& handle, const uint8_t* storage, size_t size, ValidationType validationType = ValidationType::DEFERRED)
{
    return agent.service->storeExternalData(agent, handle, &storage, &size, validationType == ValidationType::DEFERRED ? nullptr : &validationType, 1);
}

//------------------------------------------------------------------------------------------------------------------------------------
template<typename ContainerType>
OperationResult getContainer(Agent& agent, const BuildHandle& handle, const ContainerHandle& cHandle, const ContainerType*& container)
{
    container = nullptr;
    const IContainer* untypedContainer = nullptr;
    OperationResult result = agent.service->getContainer(agent, handle, cHandle, untypedContainer);
    if ((result == OperationResult::SUCCESS) && untypedContainer)
    {
        if (untypedContainer->getType() == ContainerType::getTypeStatic())
        {
            container = (const ContainerType*)untypedContainer;
        }
    }
    return container ? result : OperationResult::FAILURE;
}

//------------------------------------------------------------------------------------------------------------------------------------
inline OperationResult copyExternalStorage(datastore::IDataStore& store, const ExternalStorage& storage, std::vector<uint8_t>& outData, const datastore::GetOptions& options = datastore::GetOptionsBuilder())
{
    return (OperationResult)copyDataBlock(store, {}, storage, outData, options);
}

//------------------------------------------------------------------------------------------------------------------------------------
inline OperationResult copyExternalStorage(Agent& agent, datastore::IDataStore& store, const BuildHandle& handle, std::vector<uint8_t>& outData, const datastore::GetOptions& options = datastore::GetOptionsBuilder())
{
    uint32_t count = 1;
    ExternalStorage storage;
    OperationResult result = agent.service->getExternalData(agent, handle, &storage, &count);
    if (result != OperationResult::SUCCESS)
    {
        return result;
    }
    if (!count)
    {
        return OperationResult::OVERFLOW_ERROR;
    }
    return copyExternalStorage(store, storage, outData, options);
}

//------------------------------------------------------------------------------------------------------------------------------------
inline OperationResult copyExternalStorage(Agent& agent, datastore::IDataStore& store, const ResultHandle& handle, std::vector<uint8_t>& outData, const datastore::GetOptions& options = datastore::GetOptionsBuilder())
{
    uint32_t count = 1;
    ExternalStorage storage;
    OperationResult result = agent.agent->getRequestExternalData(handle, &storage, &count);
    if (result != OperationResult::SUCCESS)
    {
        return result;
    }

    if (!count)
    {
        return OperationResult::OVERFLOW_ERROR;
    }
    return copyExternalStorage(store, storage, outData, options);
}

//------------------------------------------------------------------------------------------------------------------------------------
inline OperationResult copyExternalStorage(Agent& agent, datastore::IDataStore& store, const RequestHandle& handle, std::vector<uint8_t>& outData, const datastore::GetOptions& options = datastore::GetOptionsBuilder())
{
    ResultHandle resultHandle;
    OperationResult result = agent.agent->getRequestResult(handle, resultHandle);
    if (result != OperationResult::SUCCESS)
    {
        return result;
    }
    result = copyExternalStorage(agent, store, resultHandle, outData, options);
    return result;
}

