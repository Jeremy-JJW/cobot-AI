    else if ((result == OperationResult::OVERFLOW_ERROR) || !outVectorResult.size())
    {
        outVectorResult.resize(externalDataSize);
        result = agent.agent->getRequestExternalData(handle, outVectorResult.data(), &externalDataSize);
    }
    return result;
}
