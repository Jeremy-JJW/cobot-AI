mdl 1.10;

import ::df::*;
import ::scene::*;
import ::math::*;
import ::anno::*;

// Convert sRGB color into linear color.
color from_srgb(
    color c_in)
{
    float3 c_out(c_in);
    const float gamma = 2.4f;
    const float a = 0.04045f;
    const float b = 0.077399f; // 1/12.92 = 0.077399
    const float c = 0.055f;
    const float d = 0.947867f; // 1/1.055 = 0.947867
    return color(
        c_out.x <= a ? c_out.x * b : math::pow((c_out.x + c) * d, gamma),
        c_out.y <= a ? c_out.y * b : math::pow((c_out.y + c) * d, gamma),
        c_out.z <= a ? c_out.z * b : math::pow((c_out.z + c) * d, gamma));
}

// Material for Points primitives, emulate flat constant shading.
export material FlatPoints(
    uniform bool use_display_color = true
    [[
      anno::display_name("Use Display Color"),
      anno::description("Use color of primitive (like point color), otherwise a constant color (Default Color).")
    ]],
    uniform color default_display_color = color(0.2, 0.2, 0.2)
    [[
      anno::display_name("Default Color"),
      anno::description("Color to be used when 'Use Display Color' is disabled or no primitive colors present.")
    ]],
    uniform bool convert_srgb_to_linear = true
    [[
      anno::display_name("Convert sRGB to Linear"),
      anno::description("Convert sRGB to linear color.")
    ]],
    uniform float intensity_scale = 5000.f
    [[
      anno::display_name("Intensity Scale"),
      anno::description("Intensity factor of emission color.")
    ]],
    uniform bool enable_transmission = false
    [[
      anno::display_name("Enable Transmission"),
      anno::description("Enable transparency scaled by transparency parameter.")
    ]],
    uniform float transparency = 10.0
    [[
      anno::display_name("Transparency"),
      anno::description("Transparency"),
      anno::hard_range(0.0, 1000.0)
    ]]
) 
[[
  anno::display_name("Flat Points"),
  anno::description("Default material for point clouds implementing flat shading."),
  anno::version( 1, 0, 0),
  anno::author("NVIDIA CORPORATION")
]]
= let 
{
    color display_color = use_display_color ? 
        scene::data_lookup_color("displayColor", default_display_color) :
        default_display_color;

    color out_color = math::emission_color(convert_srgb_to_linear ? 
        from_srgb(display_color) : 
        display_color);

    bsdf scatter_bsdf = enable_transmission ?
        df::specular_bsdf(mode: df::scatter_transmit) : 
        bsdf();

    color transmittance_color = out_color; //color(1.0);
    float transmittance_measurement_distance = transparency * 0.01;
    color volume_absorption_coefficient = -math::log(transmittance_color) / transmittance_measurement_distance;

    material_surface surface(
        scattering: scatter_bsdf,
        emission:  material_emission(df::diffuse_edf(), intensity: out_color * intensity_scale)
        );

    material_volume volume = enable_transmission ?
        material_volume(
            //scattering: df::fog_vdf(),
            scattering: df::anisotropic_vdf(),
            absorption_coefficient: volume_absorption_coefficient,
            scattering_coefficient: color(0.0)
        ) : 
        material_volume();
} 
in material(
        surface: surface,
        volume: volume
        );
