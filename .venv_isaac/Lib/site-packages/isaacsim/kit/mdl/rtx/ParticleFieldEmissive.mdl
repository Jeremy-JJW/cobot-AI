mdl 1.6;
import ::df::*;
import ::scene::*;
import ::anno::*;
import ::math::*;
import ::state::*;

// Evaluate spherical harmonics with coefficients for degrees 0, 1, 2, and 3
// migrate from https://github.com/graphdeco-inria/diff-gaussian-rasterization/blob/main/cuda_rasterizer/forward.cu#L20

export float3 sh0_eval(float3 coeffs) =
    coeffs * 0.28209479177387814;

export float3 sh1_eval(float3[3] coeffs, float3 dir) =
	- coeffs[0] * 0.4886025119029199 * dir.y +
	+ coeffs[1] * 0.4886025119029199 * dir.z +
	- coeffs[2] * 0.4886025119029199 * dir.x;

export float3 sh2_eval(float3[5] coeffs, float3 dir) = let {
    float xx = dir.x * dir.x, yy = dir.y * dir.y, zz = dir.z * dir.z;
    float xy = dir.x * dir.y, yz = dir.y * dir.z, xz = dir.x * dir.z;
} in float3
(
	coeffs[0] *  1.0925484305920792 * xy +
	coeffs[1] * -1.0925484305920792 * yz +
	coeffs[2] *  0.3153915652525200 * (2.0 * zz - xx - yy) +
	coeffs[3] * -1.0925484305920792 * xz +
	coeffs[4] *  0.5462742152960396 * (xx - yy)
);

export float3 sh3_eval(float3[7] coeffs, float3 dir) = let {
    float xx = dir.x * dir.x, yy = dir.y * dir.y, zz = dir.z * dir.z;
    float xy = dir.x * dir.y;
    // float yz = dir.y * dir.z, xz = dir.x * dir.z;
} in float3
(
	coeffs[0] * -0.590043589926643 * dir.y * (3.0 * xx - yy) +
	coeffs[1] *  2.890611442640554 * dir.z * xy +
	coeffs[2] * -0.457045799464465 * dir.y * (4.0 * zz - xx - yy) +
	coeffs[3] *  0.373176332590115 * dir.z * (2.0 * zz - 3.0f * xx - 3.0f * yy) +
	coeffs[4] * -0.457045799464465 * dir.x * (4.0 * zz - xx - yy) +
	coeffs[5] *  1.445305721320277 * dir.z * (xx - yy) +
	coeffs[6] * -0.590043589926643 * dir.x * (xx - 3.0f * yy)
);


// Spherical Harmonics degree presets enum
export enum sh_degree_presets
[[
    anno::description("Spherical Harmonics degree preset")
]]
{
    sh_degree_0 = 0 [[
        anno::display_name("Degree 0 (Constant)")
    ]],

    sh_degree_1 = 1 [[
        anno::display_name("Degree 1 (Linear)")
    ]],

    sh_degree_2 = 2 [[
        anno::display_name("Degree 2 (Quadratic)")
    ]],

    sh_degree_3 = 3 [[
        anno::display_name("Degree 3 (Cubic)")
    ]]
};

// Axis flip presets enum
export enum axis_flip_presets
[[
    anno::description("Axis flip preset for view direction")
]]
{
    axis_flip_none = 0 [[
        anno::display_name("None ( +X +Y +Z )")
    ]],

    axis_flip_x = 1 [[
        anno::display_name("Flip X ( -X +Y +Z )")
    ]],

    axis_flip_y = 2 [[
        anno::display_name("Flip Y ( +X -Y +Z )")
    ]],

    axis_flip_z = 3 [[
        anno::display_name("Flip Z ( +X +Y -Z )")
    ]],

    axis_flip_xy = 4 [[
        anno::display_name("Flip X,Y ( -X -Y +Z )")
    ]],

    axis_flip_xz = 5 [[
        anno::display_name("Flip X,Z ( -X +Y -Z )")
    ]],

    axis_flip_yz = 6 [[
        anno::display_name("Flip Y,Z ( +X -Y -Z )")
    ]],

    axis_flip_xyz = 7 [[
        anno::display_name("Flip X,Y,Z ( -X -Y -Z )")
    ]]
};

export material ParticleFieldEmissive(
    float emission_intensity = float(1.0) [[
        anno::display_name("Intensity"),
        anno::in_group("Emission"),
        anno::soft_range(0.0f, 1000.0f)
    ]],

    uniform axis_flip_presets axis_flip = axis_flip_none [[
        anno::display_name("View Direction Axis Flip"),
        anno::in_group("Spherical Harmonics"),
        anno::description("Apply sign flips to the view direction axes")
    ]],

    bool apply_srgb_linear = true [[
        anno::display_name("Convert sRGB to Linear"),
        anno::in_group("Color Correction"),
        anno::description("Convert the spherical harmonics from sRGB to linear")
    ]],

    float gamma_value = 2.4 [[
        anno::display_name("Gamma Value"),
        anno::in_group("Color Correction"),
        anno::soft_range(0.1f, 5.0f),
        anno::description("Gamma value for color correction")
    ]],

    bool apply_inverse_tonemap = true [[
        anno::display_name("Apply Inverse Tonemap"),
        anno::in_group("Color Correction"),
        anno::description("Apply inverse tonemapping to compensate for scene exposure")
    ]]
) = let {
    /*
    uniform sh_packing_presets sh_packing = sh_packing_channel_major;
    [[
        anno::display_name("SH Coefficient Packing"),
        anno::in_group("Spherical Harmonics"),
        anno::description("Choose layout of f_rest_*: interleaved or channel-major")
    ]],
    */

    // Read the degree from primvar
    int sh_degree_value = scene::data_lookup_int("radiance:sphericalHarmonicsDegree", 0);

    // Read spherical harmonics coefficients from primvars as float3
    // Degree 0 coefficients (base color)
    float3 sh_0 = scene::data_lookup_float3("radiance:sphericalHarmonicsCoefficients_0", float3(0.0));

    // Higher-order coefficients (degrees 1-3)
    float3[3] sh_1(
        scene::data_lookup_float3("radiance:sphericalHarmonicsCoefficients_1", float3(0.0)),
        scene::data_lookup_float3("radiance:sphericalHarmonicsCoefficients_2", float3(0.0)),
        scene::data_lookup_float3("radiance:sphericalHarmonicsCoefficients_3", float3(0.0))
    );

    float3[5] sh_2(
        scene::data_lookup_float3("radiance:sphericalHarmonicsCoefficients_4", float3(0.0)),
        scene::data_lookup_float3("radiance:sphericalHarmonicsCoefficients_5", float3(0.0)),
        scene::data_lookup_float3("radiance:sphericalHarmonicsCoefficients_6", float3(0.0)),
        scene::data_lookup_float3("radiance:sphericalHarmonicsCoefficients_7", float3(0.0)),
        scene::data_lookup_float3("radiance:sphericalHarmonicsCoefficients_8", float3(0.0))
    );

    float3[7] sh_3(
        scene::data_lookup_float3("radiance:sphericalHarmonicsCoefficients_9", float3(0.0)),
        scene::data_lookup_float3("radiance:sphericalHarmonicsCoefficients_10", float3(0.0)),
        scene::data_lookup_float3("radiance:sphericalHarmonicsCoefficients_11", float3(0.0)),
        scene::data_lookup_float3("radiance:sphericalHarmonicsCoefficients_12", float3(0.0)),
        scene::data_lookup_float3("radiance:sphericalHarmonicsCoefficients_13", float3(0.0)),
        scene::data_lookup_float3("radiance:sphericalHarmonicsCoefficients_14", float3(0.0)),
        scene::data_lookup_float3("radiance:sphericalHarmonicsCoefficients_15", float3(0.0))
    );

    float3 axis_flip_vec =
        axis_flip == axis_flip_none ? float3( 1,  1,  1) :
        axis_flip == axis_flip_x    ? float3(-1,  1,  1) :
        axis_flip == axis_flip_y    ? float3( 1, -1,  1) :
        axis_flip == axis_flip_z    ? float3( 1,  1, -1) :
        axis_flip == axis_flip_xy   ? float3(-1, -1,  1) :
        axis_flip == axis_flip_xz   ? float3(-1,  1, -1) :
        axis_flip == axis_flip_yz   ? float3( 1, -1, -1) :
                                      float3(-1, -1, -1) ;

    float3 view_dir = scene::data_lookup_float3("__view_direction", float3(0, 0, 1));
    float3 dir = math::normalize(state::transform_vector(state::coordinate_world, state::coordinate_object, view_dir)) * axis_flip_vec;

    // Calculate spherical harmonics color based on degree
    float3 sh_color =
        float3(0.5f) + sh0_eval(sh_0) +
        (sh_degree_value >= 1 ? sh1_eval(sh_1, dir) : float3(0.0)) +
        (sh_degree_value >= 2 ? sh2_eval(sh_2, dir) : float3(0.0)) +
        (sh_degree_value >= 3 ? sh3_eval(sh_3, dir) : float3(0.0));

    float3 scene_exposure = scene::data_lookup_float3("__exposure", float3(1, 1, 1));

    // Apply gamma correction conditionally
    float3 adjusted_color = apply_srgb_linear ?
        math::pow((sh_color + float3(0.055))/1.055, float3(gamma_value)) :
        sh_color;
    float3 final_color = apply_inverse_tonemap ?
        adjusted_color * emission_intensity / math::dot(scene_exposure, float3(0.299f, 0.587f, 0.114f)) :
        adjusted_color * emission_intensity;

    color emissive_color = final_color * math::PI;

    material_emission emission = material_emission(
        emission:
            df::diffuse_edf(),
        intensity: emissive_color,
        mode: intensity_power
    );

} in material(
    surface: material_surface(
        scattering: bsdf(),
        emission: emission
    )
);
