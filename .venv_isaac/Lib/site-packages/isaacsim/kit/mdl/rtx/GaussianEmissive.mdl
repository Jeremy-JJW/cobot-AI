mdl 1.6;
import ::df::*;
import ::scene::*;
import ::anno::*;
import ::math::*;
import ::state::*;

// Evaluate spherical harmonics with coefficients for degrees 0, 1, 2, and 3
// migrate from https://github.com/graphdeco-inria/diff-gaussian-rasterization/blob/main/cuda_rasterizer/forward.cu#L20

export float3 sh0_eval(float3 coeffs) =  
    coeffs * 0.28209479177387814;

export float3 sh1_eval(float3[3] coeffs, float3 dir) = 
	- coeffs[0] * 0.4886025119029199 * dir.y +
	+ coeffs[1] * 0.4886025119029199 * dir.z +
	- coeffs[2] * 0.4886025119029199 * dir.x;

export float3 sh2_eval(float3[5] coeffs, float3 dir) = let {
    float xx = dir.x * dir.x, yy = dir.y * dir.y, zz = dir.z * dir.z;
    float xy = dir.x * dir.y, yz = dir.y * dir.z, xz = dir.x * dir.z;
} in float3
(
	coeffs[0] *  1.0925484305920792 * xy +
	coeffs[1] * -1.0925484305920792 * yz +
	coeffs[2] *  0.3153915652525200 * (2.0 * zz - xx - yy) +
	coeffs[3] * -1.0925484305920792 * xz +
	coeffs[4] *  0.5462742152960396 * (xx - yy)
);

export float3 sh3_eval(float3[7] coeffs, float3 dir) = let {
    float xx = dir.x * dir.x, yy = dir.y * dir.y, zz = dir.z * dir.z;
    float xy = dir.x * dir.y;
    // float yz = dir.y * dir.z, xz = dir.x * dir.z;
} in float3
(
	coeffs[0] * -0.590043589926643 * dir.y * (3.0 * xx - yy) +
	coeffs[1] *  2.890611442640554 * dir.z * xy +
	coeffs[2] * -0.457045799464465 * dir.y * (4.0 * zz - xx - yy) +
	coeffs[3] *  0.373176332590115 * dir.z * (2.0 * zz - 3.0f * xx - 3.0f * yy) +
	coeffs[4] * -0.457045799464465 * dir.x * (4.0 * zz - xx - yy) +
	coeffs[5] *  1.445305721320277 * dir.z * (xx - yy) +
	coeffs[6] * -0.590043589926643 * dir.x * (xx - 3.0f * yy)
);


// Spherical Harmonics degree presets enum
export enum sh_degree_presets
[[ 
    anno::description("Spherical Harmonics degree preset")
]]
{
    sh_degree_0 = 0 [[ 
        anno::display_name("Degree 0 (Constant)")
    ]],
    
    sh_degree_1 = 1 [[ 
        anno::display_name("Degree 1 (Linear)")
    ]],
    
    sh_degree_2 = 2 [[ 
        anno::display_name("Degree 2 (Quadratic)")
    ]],
    
    sh_degree_3 = 3 [[ 
        anno::display_name("Degree 3 (Cubic)")
    ]]
};

// Axis flip presets enum
export enum axis_flip_presets
[[ 
    anno::description("Axis flip preset for view direction")
]]
{
    axis_flip_none = 0 [[ 
        anno::display_name("None ( +X +Y +Z )")
    ]],

    axis_flip_x = 1 [[ 
        anno::display_name("Flip X ( -X +Y +Z )")
    ]],

    axis_flip_y = 2 [[ 
        anno::display_name("Flip Y ( +X -Y +Z )")
    ]],

    axis_flip_z = 3 [[ 
        anno::display_name("Flip Z ( +X +Y -Z )")
    ]],

    axis_flip_xy = 4 [[ 
        anno::display_name("Flip X,Y ( -X -Y +Z )")
    ]],

    axis_flip_xz = 5 [[ 
        anno::display_name("Flip X,Z ( -X +Y -Z )")
    ]],

    axis_flip_yz = 6 [[ 
        anno::display_name("Flip Y,Z ( +X -Y -Z )")
    ]],

    axis_flip_xyz = 7 [[ 
        anno::display_name("Flip X,Y,Z ( -X -Y -Z )")
    ]]
};

// SH coefficient packing presets enum
export enum sh_packing_presets
[[ 
    anno::description("SH coefficient packing layout")
]]
{
    sh_packing_interleaved = 0 [[ 
        anno::display_name("Interleaved RGB per coeff (c0.r,g,b, c1.r,g,b ...)")
    ]],

    sh_packing_channel_major = 1 [[ 
        anno::display_name("Channel-major (R[15], G[15], B[15])")
    ]]
};

export material GaussianEmissive(
    float emission_intensity = float(1.0) [[
        anno::display_name("Intensity"),
        anno::in_group("Emission"),
        anno::soft_range(0.0f, 1000.0f)
    ]],
    
    uniform sh_degree_presets sh_degree = sh_degree_3 [[
        anno::display_name("Spherical Harmonics Degree"),
        anno::in_group("Spherical Harmonics"),
        anno::description("Degree of spherical harmonics to use for view-dependent rendering")
    ]],
    
    uniform axis_flip_presets axis_flip = axis_flip_none [[
        anno::display_name("View Direction Axis Flip"),
        anno::in_group("Spherical Harmonics"),
        anno::description("Apply sign flips to the view direction axes")
    ]],
    
    bool apply_srgb_linear = true [[
        anno::display_name("Convert sRGB to Linear"),
        anno::in_group("Color Correction"),
        anno::description("Convert the spherical harmonics from sRGB to linear")
    ]],
    
    float gamma_value = 2.4 [[
        anno::display_name("Gamma Value"),
        anno::in_group("Color Correction"),
        anno::soft_range(0.1f, 5.0f),
        anno::description("Gamma value for color correction")
    ]],
    
    bool apply_inverse_tonemap = true [[
        anno::display_name("Apply Inverse Tonemap"),
        anno::in_group("Color Correction"),
        anno::description("Apply inverse tonemapping to compensate for scene exposure")
    ]]
) = let {
    /*
    uniform sh_packing_presets sh_packing = sh_packing_channel_major;
    [[
        anno::display_name("SH Coefficient Packing"),
        anno::in_group("Spherical Harmonics"),
        anno::description("Choose layout of f_rest_*: interleaved or channel-major")
    ]],
    */
    
    // Read spherical harmonics coefficients from primvars
    // Degree 0 coefficients (base color)
    float3 sh_0 = float3(
        scene::data_lookup_float("f_dc_0", 0.0),
        scene::data_lookup_float("f_dc_1", 0.0),
        scene::data_lookup_float("f_dc_2", 0.0)
    );
    
    // logic for Alternative packing: sh_packing_interleaved.
    // Currently commented out since this part of the feature is not released and I want to avoid additional instructions.
    /*
    // Higher-order coefficients (degrees 1-3)
    float3[3] sh_1(
        float3(
            scene::data_lookup_float("f_rest_0", 0.0),
            scene::data_lookup_float("f_rest_1", 0.0),
            scene::data_lookup_float("f_rest_2", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_3", 0.0),
            scene::data_lookup_float("f_rest_4", 0.0),
            scene::data_lookup_float("f_rest_5", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_6", 0.0),
            scene::data_lookup_float("f_rest_7", 0.0),
            scene::data_lookup_float("f_rest_8", 0.0)
        )
    );
    
    float3[5] sh_2(
        float3(
            scene::data_lookup_float("f_rest_9", 0.0),
            scene::data_lookup_float("f_rest_10", 0.0),
            scene::data_lookup_float("f_rest_11", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_12", 0.0),
            scene::data_lookup_float("f_rest_13", 0.0),
            scene::data_lookup_float("f_rest_14", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_15", 0.0),
            scene::data_lookup_float("f_rest_16", 0.0),
            scene::data_lookup_float("f_rest_17", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_18", 0.0),
            scene::data_lookup_float("f_rest_19", 0.0),
            scene::data_lookup_float("f_rest_20", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_21", 0.0),
            scene::data_lookup_float("f_rest_22", 0.0),
            scene::data_lookup_float("f_rest_23", 0.0)
        )
    );
    
    float3[7] sh_3(
        float3(
            scene::data_lookup_float("f_rest_24", 0.0),
            scene::data_lookup_float("f_rest_25", 0.0),
            scene::data_lookup_float("f_rest_26", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_27", 0.0),
            scene::data_lookup_float("f_rest_28", 0.0),
            scene::data_lookup_float("f_rest_29", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_30", 0.0),
            scene::data_lookup_float("f_rest_31", 0.0),
            scene::data_lookup_float("f_rest_32", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_33", 0.0),
            scene::data_lookup_float("f_rest_34", 0.0),
            scene::data_lookup_float("f_rest_35", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_36", 0.0),
            scene::data_lookup_float("f_rest_37", 0.0),
            scene::data_lookup_float("f_rest_38", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_39", 0.0),
            scene::data_lookup_float("f_rest_40", 0.0),
            scene::data_lookup_float("f_rest_41", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_42", 0.0),
            scene::data_lookup_float("f_rest_43", 0.0),
            scene::data_lookup_float("f_rest_44", 0.0)
        )
    );
    */
    // Alternative packing: channel-major (R[15], G[15], B[15])
    float3[3] sh_1_cm(
        float3(
            scene::data_lookup_float("f_rest_0", 0.0),
            scene::data_lookup_float("f_rest_15", 0.0),
            scene::data_lookup_float("f_rest_30", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_1", 0.0),
            scene::data_lookup_float("f_rest_16", 0.0),
            scene::data_lookup_float("f_rest_31", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_2", 0.0),
            scene::data_lookup_float("f_rest_17", 0.0),
            scene::data_lookup_float("f_rest_32", 0.0)
        )
    );
    
    float3[5] sh_2_cm(
        float3(
            scene::data_lookup_float("f_rest_3", 0.0),
            scene::data_lookup_float("f_rest_18", 0.0),
            scene::data_lookup_float("f_rest_33", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_4", 0.0),
            scene::data_lookup_float("f_rest_19", 0.0),
            scene::data_lookup_float("f_rest_34", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_5", 0.0),
            scene::data_lookup_float("f_rest_20", 0.0),
            scene::data_lookup_float("f_rest_35", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_6", 0.0),
            scene::data_lookup_float("f_rest_21", 0.0),
            scene::data_lookup_float("f_rest_36", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_7", 0.0),
            scene::data_lookup_float("f_rest_22", 0.0),
            scene::data_lookup_float("f_rest_37", 0.0)
        )
    );
    
    float3[7] sh_3_cm(
        float3(
            scene::data_lookup_float("f_rest_8", 0.0),
            scene::data_lookup_float("f_rest_23", 0.0),
            scene::data_lookup_float("f_rest_38", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_9", 0.0),
            scene::data_lookup_float("f_rest_24", 0.0),
            scene::data_lookup_float("f_rest_39", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_10", 0.0),
            scene::data_lookup_float("f_rest_25", 0.0),
            scene::data_lookup_float("f_rest_40", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_11", 0.0),
            scene::data_lookup_float("f_rest_26", 0.0),
            scene::data_lookup_float("f_rest_41", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_12", 0.0),
            scene::data_lookup_float("f_rest_27", 0.0),
            scene::data_lookup_float("f_rest_42", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_13", 0.0),
            scene::data_lookup_float("f_rest_28", 0.0),
            scene::data_lookup_float("f_rest_43", 0.0)
        ),
        float3(
            scene::data_lookup_float("f_rest_14", 0.0),
            scene::data_lookup_float("f_rest_29", 0.0),
            scene::data_lookup_float("f_rest_44", 0.0)
        )
    );
    
    float3 axis_flip_vec =
        axis_flip == axis_flip_none ? float3( 1,  1,  1) :
        axis_flip == axis_flip_x    ? float3(-1,  1,  1) :
        axis_flip == axis_flip_y    ? float3( 1, -1,  1) :
        axis_flip == axis_flip_z    ? float3( 1,  1, -1) :
        axis_flip == axis_flip_xy   ? float3(-1, -1,  1) :
        axis_flip == axis_flip_xz   ? float3(-1,  1, -1) :
        axis_flip == axis_flip_yz   ? float3( 1, -1, -1) :
                                      float3(-1, -1, -1) ;

    float3 view_dir = scene::data_lookup_float3("__view_direction", float3(0, 0, 1));
    float3 dir = math::normalize(state::transform_vector(state::coordinate_world, state::coordinate_object, view_dir)) * axis_flip_vec;

    // logic for Alternative packing
    // Currently commented out since this part of the feature is not released and I want to avoid additional instructions.
    // Calculate spherical harmonics color based on degree
    // float3 sh1_term = (sh_degree >= sh_degree_1 ?
    //     (sh_packing == sh_packing_channel_major ? sh1_eval(sh_1_cm, dir) : sh1_eval(sh_1, dir)) : float3(0.0));
    // float3 sh2_term = (sh_degree >= sh_degree_2 ?
    //     (sh_packing == sh_packing_channel_major ? sh2_eval(sh_2_cm, dir) : sh2_eval(sh_2, dir)) : float3(0.0));
    // float3 sh3_term = (sh_degree >= sh_degree_3 ?
    //     (sh_packing == sh_packing_channel_major ? sh3_eval(sh_3_cm, dir) : sh3_eval(sh_3, dir)) : float3(0.0));

    // float3 sh_color = float3(0.5f) + sh0_eval(sh_0) + sh1_term + sh2_term + sh3_term;

    float3 sh_color =
        float3(0.5f) + sh0_eval(sh_0) +
        (sh_degree >= sh_degree_1 ? sh1_eval(sh_1_cm, dir) : float3(0.0)) +
        (sh_degree >= sh_degree_2 ? sh2_eval(sh_2_cm, dir) : float3(0.0)) +
        (sh_degree >= sh_degree_3 ? sh3_eval(sh_3_cm, dir) : float3(0.0));

    float3 scene_exposure = scene::data_lookup_float3("__exposure", float3(1, 1, 1));
    
    // Apply gamma correction conditionally
    float3 adjusted_color = apply_srgb_linear ? 
        math::pow((sh_color + float3(0.055))/1.055, float3(gamma_value)) : 
        sh_color;
    float3 final_color = apply_inverse_tonemap ?
        adjusted_color * emission_intensity / math::dot(scene_exposure, float3(0.299f, 0.587f, 0.114f)) :
        adjusted_color * emission_intensity;
    
    color emissive_color = final_color * math::PI;
    
    material_emission emission = material_emission(
        emission: 
            df::diffuse_edf(),
        intensity: emissive_color,
        mode: intensity_power
    );

} in material(
    surface: material_surface(
        scattering: bsdf(),
        emission: emission
    )
); 