{
  "global_limits": {
    "max_distance_mm": 200,
    "max_sequence_steps": 10,
    "default_speed_percent": 30,
    "max_speed_percent": 80,
    "max_wait_seconds": 10
  },
  "skills": {
    "move_relative_linear": {
      "description": "相對當前位姿直線移動",
      "params": {
        "axis": { "type": "string", "enum": ["x", "y", "z"], "required": true },
        "direction": { "type": "string", "enum": ["+", "-"], "required": true },
        "distance_mm": { "type": "number", "min": 0.1, "max": 200, "required": true },
        "speed_percent": { "type": "number", "min": 1, "max": 50, "default": 30 }
      },
      "examples": [
        "向 X 正方向移動 100 毫米",
        "向 Z 負方向移動 50mm",
        "抬高 100 毫米",
        "下降 50 毫米"
      ]
    },
    "move_relative_sequence": {
      "description": "按順序多次相對直線移動（最多 10 步，如先 X+ 再 Y+ 再 Z+）",
      "params": {
        "steps": { "type": "array", "required": true },
        "speed_percent": { "type": "number", "min": 1, "max": 50, "default": 30 }
      },
      "examples": [
        "先 x+50mm，再 y+50mm",
        "先向 X 正方向移動 50 毫米，再向 Y 正方向移動 50 毫米",
        "先抬高 10 毫米，然後向 X 正方向移動 20 毫米，接着向 Y 正方向移動 20 毫米",
        "第一步向 X 正方向移動 30 毫米，第二步向 Y 正方向移動 30 毫米，第三步抬高 20 毫米",
        "先 x+20，再 y+20，再 z+20，再 x-20，再 y-20，再 z-20，再 x+10，再 y+10，再 z+10，再 x-10"
      ]
    },
    "move_to_named_point": {
      "description": "移動到命名點位",
      "params": {
        "point": { "type": "string", "required": true },
        "move_type": { "type": "string", "enum": ["movj", "movl"], "default": "movj" },
        "speed_percent": { "type": "number", "min": 1, "max": 50, "default": 30 }
      },
      "examples": ["移動到 A 點", "去 point_a", "回到 home"]
    },
    "move_between_points": {
      "description": "在兩個命名點之間運動",
      "params": {
        "from_point": { "type": "string", "required": true },
        "to_point": { "type": "string", "required": true },
        "move_type": { "type": "string", "enum": ["movj", "movl"], "default": "movj" },
        "speed_percent": { "type": "number", "min": 1, "max": 50, "default": 30 }
      },
      "examples": ["從 A 點移動到 B 點", "從 point_a 到 point_b"]
    },
    "motion_pattern": {
      "description": "執行預置複合運動路線，底層僅調用 dobot_api.py 中已有的 MovL、Arc、Circle",
      "params": {
        "pattern": {
          "type": "string",
          "enum": [
            "circle_xy",
            "circle_xz",
            "circle_yz",
            "arc_xy",
            "arc_xz",
            "arc_yz",
            "square_xy",
            "rectangle_xy",
            "triangle_xy",
            "diamond_xy",
            "cross_xy",
            "zigzag_x",
            "wave_y",
            "u_shape_xy",
            "xyz_step_return",
            "xz_lift_return",
            "yz_lift_return",
            "l_shape_xyz",
            "box_outline",
            "spiral_z"
          ],
          "required": true
        },
        "size_mm": { "type": "number", "min": 5, "max": 200, "default": 50 },
        "radius_mm": { "type": "number", "min": 5, "max": 100, "default": 30 },
        "height_mm": { "type": "number", "min": -200, "max": 200, "default": 50 },
        "turns": { "type": "number", "min": 1, "max": 5, "default": 2 },
        "speed_percent": { "type": "number", "min": 1, "max": 50, "default": 30 }
      },
      "examples": [
        "畫圓",
        "在 XY 平面畫圓",
        "走三維螺旋運動",
        "先運動 X+ 再運動 Y+ 再運動 Z+ 再回到原點",
        "走方形路線",
        "走箱體輪廓"
      ]
    },
    "set_speed": {
      "description": "設置全局速度比例",
      "params": {
        "speed_percent": { "type": "number", "min": 1, "max": 50, "required": true }
      },
      "examples": ["速度設置爲 30%", "速度調到 20"]
    },
    "wait": {
      "description": "等待指定秒數",
      "params": {
        "seconds": { "type": "number", "min": 0.1, "max": 10, "required": true }
      },
      "examples": ["等待 2 秒", "停 1.5 秒"]
    },
    "read_pose": {
      "description": "讀取當前位姿（用於標定或調試）",
      "params": {
        "save_as": { "type": "string", "required": false }
      },
      "examples": ["讀取當前位置", "記錄當前位置爲 home"]
    },
    "stop_or_disable": {
      "description": "停止運動或下使能",
      "params": {
        "action": { "type": "string", "enum": ["stop", "disable"], "default": "stop" }
      },
      "examples": ["停止運動", "下使能"]
    },
    "enable_robot": {
      "description": "上使能機械臂",
      "params": {},
      "examples": ["上使能", "上使能機械臂"]
    },
    "move_joint": {
      "description": "控制單個關節旋轉",
      "params": {
        "joint": { "type": "string", "enum": ["J1","J2","J3","J4","J5","J6"], "required": true },
        "direction": { "type": "string", "enum": ["+", "-"], "required": true },
        "angle_deg": { "type": "number", "min": 1, "max": 360, "required": true },
        "speed_percent": { "type": "number", "min": 1, "max": 50, "default": 30 }
      },
      "examples": [
        "J1 正方向旋轉 180 度",
        "J2 負方向轉 90 度",
        "J3 正轉 45 度"
      ]
    },
    "move_to_program_point": {
      "description": "運動到程序內存點 Pn（笛卡爾）",
      "params": {
        "point": { "type": "string", "required": true },
        "move_type": { "type": "string", "enum": ["movj", "movl"], "default": "movj" },
        "speed_percent": { "type": "number", "min": 1, "max": 50, "default": 30 }
      },
      "examples": ["運動到 P1", "直線運動到 P2", "去 P3"]
    },
    "set_do": {
      "description": "設置數字輸出 DO 端口狀態",
      "params": {
        "index": { "type": "number", "min": 1, "max": 16, "required": true },
        "state": { "type": "string", "enum": ["ON", "OFF"], "required": true }
      },
      "examples": ["置 DO1 為 ON", "DO2 關閉"]
    },
    "wait_di": {
      "description": "等待數字輸入 DI 達到指定狀態",
      "params": {
        "index": { "type": "number", "min": 1, "max": 16, "required": true },
        "state": { "type": "string", "enum": ["ON", "OFF"], "required": true },
        "timeout_seconds": { "type": "number", "min": 0.1, "max": 60, "default": 10 }
      },
      "examples": ["等待 DI1 為 ON", "等到 DI3 為 OFF"]
    }
  }
}
